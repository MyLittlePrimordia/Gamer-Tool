<?xml version="1.0" encoding="utf-8"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">

  <!--
    Gamer Tool never needs administrator rights: gamma ramps (GDI32) and the
    per-user Run key (HKCU) both operate at standard user privilege. Declaring
    asInvoker explicitly (rather than relying on the SDK's implicit default)
    means Windows never shows a UAC prompt on launch and never silently
    virtualizes registry/file writes into a compatibility shim.
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- Declares Windows 10/11 compatibility so GamerTool gets current-version
       Shell/DWM behavior (accurate DPI info, current Shell_NotifyIcon
       semantics) instead of being treated as a legacy app needing compat
       shims. -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
    </application>
  </compatibility>

  <!-- Per-monitor v2 DPI awareness so gamma preview rendering and custom
       chrome sizing stay pixel-accurate across mixed-DPI multi-monitor setups. -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/PM</dpiAware>
    </windowsSettings>
  </application>

</assembly>
