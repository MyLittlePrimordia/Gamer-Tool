<Window x:Class="GamerTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:GamerTool.UI"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Gamer Tool"
        Width="1200"
        Height="790"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="{StaticResource Sans}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- Custom chrome: the OS caption strip is gone, so the whole window is one
         unbroken black surface and the caption buttons are ours to draw. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ui:InverseBoolToVisibilityConverter x:Key="InverseBool" />
    </Window.Resources>

        <!-- The whole app is drawn as one rounded card floating inside a
             transparent window, so the frame, the tab switcher, the caption
             buttons and the status line all sit inside the same rounded edge
             instead of running to the corners of a black rectangle.

             The frame line is the card showing through a one pixel inset rather
             than a Border brush, because a border is drawn on the card's own
             edge and the card is what the rounded clip has to line up with. -->
    <Border x:Name="AppFrame" CornerRadius="{StaticResource RadiusFrame}" Background="{StaticResource LineStrong}">
        <Grid x:Name="ShellGrid" Margin="1" Background="{StaticResource AppBg}">
        <!-- A Border's CornerRadius does not clip its child, so the contents get
             their own matching clip. The numbers are the card's inner size: the
             window is a fixed 1200 x 790 and the inset above takes one pixel off
             each edge, leaving 1198 x 788 with the corner radius one less. The
             old clip said 1200 x 790, which sat outside this grid entirely, so
             the rounded corners never applied and the opaque status bar painted
             square over the two bottom ones. -->
        <Grid.Clip>
            <RectangleGeometry Rect="0,0,1198,788" RadiusX="13" RadiusY="13" />
        </Grid.Clip>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- ============ TITLE BAR ============ -->
        <!-- Title on the left, the tab switcher in the middle and the window
             buttons on the right, all on one strip inside the frame. -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent"
              MouseLeftButtonDown="OnTitleBarDragDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="16,0,0,0" Background="Transparent">
                <ui:EmojiImage Glyph="gamepad" Width="19" Height="19" VerticalAlignment="Center" />
                <TextBlock Text="Gamer Tool" Margin="9,0,0,0" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextHi}" VerticalAlignment="Center" />
            </StackPanel>

            <Border Grid.Column="1" Style="{StaticResource NavTrack}" VerticalAlignment="Center">
                <UniformGrid Columns="4" Rows="1">
                    <ui:NavPill x:Name="NavDisplay" Style="{StaticResource NavDisplay}" GroupName="Nav" AutomationProperties.Name="Display tab"
                                IsChecked="True" Checked="OnNavChanged" />
                    <ui:NavPill x:Name="NavAudio" Style="{StaticResource NavAudio}" GroupName="Nav" AutomationProperties.Name="Audio tab" Checked="OnNavChanged" />
                    <ui:NavPill x:Name="NavHotkeys" Style="{StaticResource NavHotkeys}" GroupName="Nav" AutomationProperties.Name="Hotkeys tab" Checked="OnNavChanged" />
                    <ui:NavPill x:Name="NavSettings" Style="{StaticResource NavSettings}" GroupName="Nav" AutomationProperties.Name="Settings tab" Checked="OnNavChanged" />
                </UniformGrid>
            </Border>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="CaptionMinButton" Style="{StaticResource CaptionButton}"
                                        Click="OnCaptionMinClick" ToolTip="Hide">
                                    <Path Data="M 0 0 L 10 0" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                                </Button>
                                <Button x:Name="CaptionCloseButton" Style="{StaticResource CaptionClose}"
                                        Click="OnCaptionCloseClick" ToolTip="Close">
                                    <Path Data="M 0 0 L 9 9 M 9 0 L 0 9" StrokeThickness="1.1"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                                </Button>
                            </StackPanel>
        </Grid>

        <!-- ============ BODY ============ -->
        <Grid Grid.Row="1" Margin="18,4,18,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TabControl Grid.Row="0" x:Name="Pages" Style="{StaticResource HiddenTabs}">
                <!-- ================================================================
                     DISPLAY  ·  16:9 preview on the left, every control on the right
                     ================================================================ -->
                <TabItem>
                    <Border Style="{StaticResource PagePanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="54" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="56" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="18,0">
                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- The picker and the three things you can do to it
                                     are one group, right aligned, rather than a
                                     centred dropdown with the actions stranded in
                                     the far corner. They used to be about 470
                                     pixels apart, which is a long way to drag for
                                     a button that acts on the thing you just
                                     clicked, and it left the middle of the row
                                     empty on both tabs. -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <ComboBox x:Name="DisplayPresetBox" Style="{StaticResource PresetCombo}"
                                              ItemContainerStyle="{StaticResource ModernComboItem}"
                                              ItemTemplate="{StaticResource PresetChoiceItem}"
                                              Width="300" Margin="0,0,12,0"
                                              HorizontalContentAlignment="Center" SelectionChanged="OnDisplayPresetSelected"
                                              ToolTip="Screen preset" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:IconButton x:Name="DisplaySaveButton" Style="{StaticResource IconButton}" Icon="{x:Static ui:Icons.Plus}"
                                                       Margin="0,0,6,0" Click="OnSaveAsScreenClick" ToolTip="Save Preset" AutomationProperties.Name="Save this screen preset" />
                                        <ui:IconButton x:Name="DisplayRenameButton" Style="{StaticResource IconButton}" Icon="{x:Static ui:Icons.Pencil}"
                                                       Margin="0,0,6,0" Click="OnRenameScreenClick" ToolTip="Rename Preset" AutomationProperties.Name="Rename this screen preset" />
                                        <ui:IconButton x:Name="DisplayDeleteButton" Style="{StaticResource IconButton}" Icon="{x:Static ui:Icons.Trash}"
                                                       Click="OnDeleteScreenClick" ToolTip="Delete Preset" AutomationProperties.Name="Delete this screen preset" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="0" Style="{StaticResource Hairline}" VerticalAlignment="Bottom" Margin="18,0" />

                            <Grid Grid.Row="1" Margin="18,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="430" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- left: the 16:9 preview and nothing else. Pinned to
                                     the top so the spare height collects below it rather
                                     than splitting into a gap above and below. -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,18,0,18">
                                    <Border Style="{StaticResource Hero}" Padding="10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="230" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Style="{StaticResource SectionHeader}" Text="PREVIEW" Margin="0" VerticalAlignment="Center" />
                                                <!-- One control, not two. Two buttons with a
                                                     highlight each read as a pair of unrelated
                                                     buttons; a single button that names the
                                                     scene on screen reads as one switch. -->
                                                <Button x:Name="PreviewSceneButton" Grid.Column="1"
                                                        Style="{StaticResource PillTab}"
                                                        Click="OnPreviewSceneClick" ToolTip="Day scene">
                                                    <ui:EmojiImage x:Name="PreviewSceneGlyph" Glyph="sun" Width="18" Height="18" />
                                                </Button>
                                            </Grid>
                                            <!-- 410 x 230 is exactly 16:9, so the scene is
                                                 never letterboxed or cropped. The rounded
                                                 corners are a clip on the image itself:
                                                 a Border's CornerRadius does not clip
                                                 its child, and ClipToBounds only cuts
                                                 to the square slot, so the scene would
                                                 otherwise spill over the rounding. -->
                                            <Border Grid.Row="1" x:Name="PreviewFrame" CornerRadius="10" Background="#020202"
                                                    SizeChanged="OnPreviewFrameSizeChanged">
                                                <Image x:Name="PreviewImage" Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                </StackPanel>

                                <Border Grid.Column="1" Style="{StaticResource VHairline}" Margin="0,18" />

                                <!-- right: every control, grouped by what it does -->
                                <Grid Grid.Column="2" Margin="0,18,0,18">
                                    <Grid.RowDefinitions>
                                        <!-- Every row sizes to its own content, and the
                                             slack goes into a trailing star row at the
                                             bottom.

                                             Row zero used to be the star, with the four
                                             sliders top aligned inside it. That put
                                             every spare pixel in the middle of the panel,
                                             between the sliders and whatever came next,
                                             which read as a hole in the layout rather
                                             than as space. The comment that stood here
                                             argued that the leftover height was better
                                             off under the top row, which was the problem
                                             restated: under the top row is still the
                                             middle of the panel.

                                             A trailing star row cannot do that. Nothing
                                             above it absorbs anything, so the stack runs
                                             4 sliders, colour trim, hardware backlight,
                                             and stops. Whatever is left over falls off the
                                             end, where space reads as space, and it is
                                             where the backlight rows appear once the
                                             feature is switched on.

                                             Four rows, not six. The backlight section
                                             no longer has a hairline above and below
                                             it, so the two rows that bracketed those
                                             rules are gone rather than left in as
                                             empty Auto rows. -->
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Two Auto rows with each pair centred, rather than
                                         two star rows that would push the top pair to
                                         the ceiling and the bottom pair to the floor.
                                         Nothing here absorbs spare height any more, so
                                         this block sits directly under the one above it
                                         and the empty space lands at the foot of the
                                         column, where the backlight rows appear. -->
                                    <Grid Grid.Row="0" VerticalAlignment="Top">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,20">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource Label}" Text="Gamma" />
                                                <TextBlock x:Name="GammaValue" Grid.Column="1" Style="{StaticResource Value}" Text="1.00" />
                                            </Grid>
                                            <Slider x:Name="GammaSlider" ui:SliderSnap.Neutral="1.0" ui:SliderSnap.Threshold="0.02" Style="{StaticResource ModernSlider}" Foreground="{StaticResource AccentDisplay}"
                                                    Minimum="1" Maximum="3" TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="OnScreenSliderChanged"
                                                    ToolTip="Gamma" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,0,20">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource Label}" Text="Shadow boost" />
                                                <TextBlock x:Name="ShadowValue" Grid.Column="1" Style="{StaticResource Value}" Text="+0%" />
                                            </Grid>
                                            <Slider x:Name="ShadowSlider" ui:SliderSnap.Neutral="0" ui:SliderSnap.Threshold="1.2" Style="{StaticResource ModernSlider}" Foreground="{StaticResource AccentDisplay}"
                                                    Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnScreenSliderChanged"
                                                    ToolTip="Shadow boost" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,20,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource Label}" Text="Brightness" />
                                                <TextBlock x:Name="BrightValue" Grid.Column="1" Style="{StaticResource Value}" Text="+0%" />
                                            </Grid>
                                            <Slider x:Name="BrightSlider" ui:SliderSnap.Neutral="0" ui:SliderSnap.Threshold="1.2" Style="{StaticResource ModernSliderBipolar}" Foreground="{StaticResource AccentDisplay}"
                                                    Minimum="-50" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnScreenSliderChanged"
                                                    ToolTip="Brightness" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="0,20,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource Label}" Text="Contrast" />
                                                <TextBlock x:Name="ContrastValue" Grid.Column="1" Style="{StaticResource Value}" Text="+0%" />
                                            </Grid>
                                            <Slider x:Name="ContrastSlider" ui:SliderSnap.Neutral="0" ui:SliderSnap.Threshold="1.2" Style="{StaticResource ModernSliderBipolar}" Foreground="{StaticResource AccentDisplay}"
                                                    Minimum="-50" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnScreenSliderChanged"
                                                    ToolTip="Contrast" />
                                        </StackPanel>
                                    </Grid>
                                    <!-- 22 above, which is the gap a row of labels
                                         wants when the row above it also ends in a
                                         label and a slider. It was flush, so the
                                         Colour trim caption sat a few pixels under
                                         the Brightness slider and read as part of
                                         it. Space rather than a rule, because a
                                         hairline between two sets of sliders in the
                                         same panel is a division nobody asked for.

                                         The three columns are the same star, 40, star
                                         as the four sliders above, and that is the whole
                                         of the alignment. The blue light filter sits
                                         in this grid's third column and Contrast sits
                                         in that grid's third column, and two grids of
                                         identical proportions across the same width put
                                         their third columns in the same place, so the
                                         caption and the drop down line up with Contrast
                                         by construction. It was a fixed 232, which
                                         pinned the box to the right edge and left its
                                         caption 120 pixels to the right of Contrast's
                                         with nothing holding the two together.

                                         The drop down is as wide as the Contrast
                                         slider as a result, which is the point: it is
                                         the same control in the same column doing
                                         the same job, and a narrower box under a
                                         wider one read as a stray. -->
                                    <Grid Grid.Row="1" Margin="0,22,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- No neutral button here on purpose. The footer
                                             reset already puts all three channels back to
                                             1.00 along with everything else, and the
                                             blue light box on the right is the warm and
                                             cool control, so a second button that only did
                                             a third of the reset was clutter. -->
                                        <Grid Grid.Column="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <!-- The caption is centred on the same
                                                 three column shape the faders below
                                                 sit in, rather than on a spanned
                                                 range across a different grid. The
                                                 two used to be separate grids, so
                                                 the caption could not be guaranteed
                                                 to land over the middle fader and
                                                 in the screenshot it did not. One
                                                 shape, used twice, cannot disagree.

                                                 It sits on the left of that line
                                                 rather than centred, because it is
                                                 now a Label beside Gamma and
                                                 Shadow boost rather than a section
                                                 heading, and a label lines up
                                                 with the labels above it. -->
                                            <!-- Section name only. This used to carry a
                                                 "NEUTRAL IS 1.00" caption centred
                                                 over the middle fader, on a three
                                                 column grid matching the faders
                                                 below so the two could not disagree
                                                 about where the middle was. The
                                                 readouts under each fader retired
                                                 it: they say 1.00 when the channel
                                                 is at neutral, so the hint was
                                                 stating something the panel now
                                                 shows. The grid that existed only
                                                 to centre that caption went with
                                                 it. -->
                                            <!-- Same Label style as Gamma and Shadow
                                                 boost, one row up. This was a
                                                 SectionHeader, which is 9.5 point
                                                 semi-bold in the dimmest text colour
                                                 and reads as a section heading - so
                                                 three headings in a column of slider
                                                 labels, in a different face and a
                                                 different colour from the six labels
                                                 beside them. A colour trim is a
                                                 slider group, not a chapter. -->
                                            <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="Colour trim" />

                                            <!-- A letter above, a number below, both
                                                 centred on the fader between them.
                                                 Reading a channel is a vertical
                                                 act, so the name sits at the top
                                                 where the eye starts and the
                                                 value at the bottom next to the
                                                 end of the travel, and a value on
                                                 the same line as its name pushed
                                                 the number out to the side of the
                                                 fader where it read as belonging
                                                 to the next channel along.

                                                 Auto height rather than the fixed
                                                 112 this had, because there is a
                                                 line above and a line below the
                                                 fader now and a fixed height
                                                 would clip one of them at a
                                                 larger DPI. The fader keeps its
                                                 own 92. -->
                                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                            <TextBlock x:Name="RedLabel" Style="{StaticResource Label}" Text="R"
                                                       Foreground="#F87171" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" Margin="0,0,0,6" />
                                            <Slider x:Name="RedSlider" ui:SliderSnap.Neutral="1.0" ui:SliderSnap.Threshold="0.012" Style="{StaticResource BandSliderVertical}" Foreground="#F87171"
                                                    Width="28" Height="92" Minimum="0.7" Maximum="1.3" TickFrequency="0.01"
                                                    IsSnapToTickEnabled="True" ValueChanged="OnScreenSliderChanged" ToolTip="Red" AutomationProperties.Name="Red channel trim" />
                                            <TextBlock x:Name="RedValue" Style="{StaticResource Value}" Text="1.00"
                                                       HorizontalAlignment="Center" Margin="0,6,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                            <TextBlock x:Name="GreenLabel" Style="{StaticResource Label}" Text="G"
                                                       Foreground="#34D399" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" Margin="0,0,0,6" />
                                            <Slider x:Name="GreenSlider" ui:SliderSnap.Neutral="1.0" ui:SliderSnap.Threshold="0.012" Style="{StaticResource BandSliderVertical}" Foreground="#34D399"
                                                    Width="28" Height="92" Minimum="0.7" Maximum="1.3" TickFrequency="0.01"
                                                    IsSnapToTickEnabled="True" ValueChanged="OnScreenSliderChanged" ToolTip="Green" AutomationProperties.Name="Green channel trim" />
                                            <TextBlock x:Name="GreenValue" Style="{StaticResource Value}" Text="1.00"
                                                       HorizontalAlignment="Center" Margin="0,6,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                            <TextBlock x:Name="BlueLabel" Style="{StaticResource Label}" Text="B"
                                                       Foreground="#60A5FA" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" Margin="0,0,0,6" />
                                            <Slider x:Name="BlueSlider" ui:SliderSnap.Neutral="1.0" ui:SliderSnap.Threshold="0.012" Style="{StaticResource BandSliderVertical}" Foreground="#60A5FA"
                                                    Width="28" Height="92" Minimum="0.7" Maximum="1.3" TickFrequency="0.01"
                                                    IsSnapToTickEnabled="True" ValueChanged="OnScreenSliderChanged" ToolTip="Blue" AutomationProperties.Name="Blue channel trim" />
                                            <TextBlock x:Name="BlueValue" Style="{StaticResource Value}" Text="1.00"
                                                       HorizontalAlignment="Center" Margin="0,6,0,0" />
                                        </StackPanel>

                                            </Grid>
                                        </Grid>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                            <TextBlock Style="{StaticResource Label}" Text="Blue light filter" Margin="0,0,0,10" />
                                            <ComboBox x:Name="BlueLightBox" Style="{StaticResource ModernCombo}"
                                                      ItemContainerStyle="{StaticResource ModernComboItem}" SelectionChanged="OnBlueLightChanged"
                                                      ToolTip="Blue Light" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Hardware backlight. Built in code because it is
                                         one row per display and each row decides for
                                         itself whether it is live: a machine can have
                                         one monitor that answers DDC/CI and another
                                         with no pathway at all, and the two must not
                                         share a single enabled state. The software
                                         brightness above is untouched either way.

                                         Last in the column rather than tucked directly
                                         under the four sliders, for two reasons that
                                         point the same way. It is a different layer:
                                         everything above it is a curve this app draws,
                                         while this is the panel's own backlight. And it
                                         is the only section that comes and goes, so
                                         putting it at the bottom means switching it on
                                         fills space that was going to be empty anyway,
                                         instead of opening a hole in the middle of it.

                                         No rules above or below. It used to have a
                                         hairline on each side, which was there to
                                         separate it from the colour section when it
                                         sat in the middle. At the foot of the column
                                         there is nothing to separate it from: every
                                         control in this panel is a display slider,
                                         and a rule between them divides a list that
                                         was never in two. -->
                                    <StackPanel x:Name="BacklightPanel" Grid.Row="2" Margin="0,26,0,0" />
                                </Grid>
                            </Grid>

                            <Border Grid.Row="2" Style="{StaticResource Hairline}" VerticalAlignment="Top" Margin="18,0" />
                            <!-- Actions centred, live state tucked right. The three tabs
                                 share this shape so the divider sits at the same height
                                 everywhere. -->
                            <Grid Grid.Row="2" Margin="18,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Apply" Style="{StaticResource PrimaryButton}" MinWidth="116"
                                            Click="OnApplyScreenClick" ToolTip="Apply" AutomationProperties.Name="Apply the screen preset" />
                                    <ui:IconButton Icon="{x:Static ui:Icons.Refresh}" Style="{StaticResource IconButton}" Margin="10,0,0,0"
                                                   Click="OnResetScreenClick" ToolTip="Reset" AutomationProperties.Name="Reset the screen to normal" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                            VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Ellipse x:Name="ScreenLiveDot" Width="6" Height="6" Fill="{StaticResource Green}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock x:Name="ScreenLiveText" Style="{StaticResource CardSub}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </TabItem>

                <!-- ================================================================
                     AUDIO  ·  16:9 spectrum on the left, 16:9 equalizer on the right
                     ================================================================ -->
                <TabItem>
                    <Border Style="{StaticResource PagePanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="54" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="56" />
                            </Grid.RowDefinitions>


                            <Grid Grid.Row="0" Margin="18,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Same right aligned group as the Display tab, for
                                     the same reason: the picker and its three
                                     actions belong together, not at opposite ends
                                     of the row. -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <ComboBox x:Name="AudioPresetBox" Style="{StaticResource PresetCombo}"
                                              ItemContainerStyle="{StaticResource ModernComboItem}"
                                              ItemTemplate="{StaticResource PresetChoiceItem}"
                                              Width="300" Margin="0,0,12,0"
                                              HorizontalContentAlignment="Center" SelectionChanged="OnAudioPresetSelected"
                                              ToolTip="Sound preset" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:IconButton x:Name="AudioSaveButton" Style="{StaticResource IconButton}" Icon="{x:Static ui:Icons.Plus}"
                                                       Margin="0,0,6,0" Click="OnSaveAsSoundClick" ToolTip="Save Preset" AutomationProperties.Name="Save this sound preset" />
                                        <ui:IconButton x:Name="AudioRenameButton" Style="{StaticResource IconButton}" Icon="{x:Static ui:Icons.Pencil}"
                                                       Margin="0,0,6,0" Click="OnRenameSoundClick" ToolTip="Rename Preset" AutomationProperties.Name="Rename this sound preset" />
                                        <ui:IconButton x:Name="AudioDeleteButton" Style="{StaticResource IconButton}" Icon="{x:Static ui:Icons.Trash}"
                                                       Click="OnDeleteSoundClick" ToolTip="Delete Preset" AutomationProperties.Name="Delete this sound preset" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="0" Style="{StaticResource Hairline}" VerticalAlignment="Bottom" Margin="18,0" />

                            <Grid Grid.Row="1" Margin="18,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="430" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- left: 16:9 spectrum, then the effect sliders packed
                                     tight underneath so the faders keep their room -->
                                <Grid Grid.Column="0" Margin="0,18,0,18">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Style="{StaticResource Hero}" Padding="10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="230" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Style="{StaticResource SectionHeader}" Text="SPECTRUM" Margin="0" VerticalAlignment="Center" />
                                                <!-- Centred, with the track toggle on the right
                                                     mirroring the day and night control on the
                                                     display preview, so the two boxes read the
                                                     same way. -->
                                                <ui:IconButton x:Name="AudioPreviewButton" Grid.Column="1" Style="{StaticResource IconButton}"
                                                              IconSize="15" Click="OnAudioPreviewClick" ToolTip="Play" />
                                                <Button x:Name="PreviewTrackButton" Grid.Column="2" Style="{StaticResource PillTab}"
                                                        HorizontalAlignment="Right" Margin="0"
                                                        Click="OnPreviewTrackClick" ToolTip="Music">
                                                    <ui:EmojiImage x:Name="PreviewTrackGlyph" Glyph="gamepad" Width="18" Height="18" />
                                                </Button>
                                            </Grid>
                                            <Border Grid.Row="1" CornerRadius="10" ClipToBounds="True" Background="#000000" Padding="5,4,0,0">
                                                <Grid x:Name="SpectrumHost" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="1" Style="{StaticResource Hairline}" Margin="0,14,0,10" />

                                    <StackPanel Grid.Row="2">
                                        <TextBlock Style="{StaticResource SectionHeader}" Text="EFFECTS AND ENGINE" Margin="0,0,0,12" />
                                        <!-- Label, slider and readout share one line. The stacked

                                             version needed 80 more pixels than the panel had, which

                                             silently cut the last two effects off the bottom. -->

                                        <Grid>

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="*" />

                                                <ColumnDefinition Width="24" />

                                                <ColumnDefinition Width="*" />

                                            </Grid.ColumnDefinitions>

                                            <Grid.RowDefinitions>

                                                <RowDefinition Height="Auto" />

                                                <RowDefinition Height="Auto" />

                                                <RowDefinition Height="Auto" />

                                                <RowDefinition Height="Auto" />

                                                <RowDefinition Height="Auto" />

                                            </Grid.RowDefinitions>



                                            <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,0,7" VerticalAlignment="Center">

                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="80" />

                                                    <ColumnDefinition Width="*" />

                                                    <ColumnDefinition Width="32" />

                                                </Grid.ColumnDefinitions>

                                                <TextBlock Style="{StaticResource Label}" Text="Clarity" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                                <Slider x:Name="ClaritySlider" ui:SliderSnap.Neutral="0" ui:SliderSnap.Threshold="0.25" Grid.Column="1" Style="{StaticResource ModernSlider}" Foreground="{StaticResource AccentAudio}"

                                                        Minimum="0" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="OnSoundSliderChanged"

                                                        Margin="8,0" VerticalAlignment="Center" ToolTip="Clarity" />

                                                <TextBlock x:Name="ClarityValue" Grid.Column="2" Style="{StaticResource Value}" Text="0.0" HorizontalAlignment="Right" />

                                            </Grid>



                                            <Grid Grid.Row="0" Grid.Column="2" Margin="0,0,0,7" VerticalAlignment="Center">

                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="80" />

                                                    <ColumnDefinition Width="*" />

                                                    <ColumnDefinition Width="32" />

                                                </Grid.ColumnDefinitions>

                                                <TextBlock Style="{StaticResource Label}" Text="Ambience" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                                <Slider x:Name="AmbienceSlider" ui:SliderSnap.Neutral="0" ui:SliderSnap.Threshold="0.25" Grid.Column="1" Style="{StaticResource ModernSlider}" Foreground="{StaticResource AccentAudio}"

                                                        Minimum="0" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="OnSoundSliderChanged"

                                                        Margin="8,0" VerticalAlignment="Center" ToolTip="Ambience" />

                                                <TextBlock x:Name="AmbienceValue" Grid.Column="2" Style="{StaticResource Value}" Text="0.0" HorizontalAlignment="Right" />

                                            </Grid>



                                            <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,0,7" VerticalAlignment="Center">

                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="80" />

                                                    <ColumnDefinition Width="*" />

                                                    <ColumnDefinition Width="32" />

                                                </Grid.ColumnDefinitions>

                                                <TextBlock Style="{StaticResource Label}" Text="Surround" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                                <Slider x:Name="SurroundSlider" ui:SliderSnap.Neutral="0" ui:SliderSnap.Threshold="0.25" Grid.Column="1" Style="{StaticResource ModernSlider}" Foreground="{StaticResource AccentAudio}"

                                                        Minimum="0" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="OnSoundSliderChanged"

                                                        Margin="8,0" VerticalAlignment="Center" ToolTip="Surround" />

                                                <TextBlock x:Name="SurroundValue" Grid.Column="2" Style="{StaticResource Value}" Text="0.0" HorizontalAlignment="Right" />

                                            </Grid>



                                            <Grid Grid.Row="1" Grid.Column="2" Margin="0,0,0,7" VerticalAlignment="Center">

                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="80" />

                                                    <ColumnDefinition Width="*" />

                                                    <ColumnDefinition Width="32" />

                                                </Grid.ColumnDefinitions>

                                                <TextBlock Style="{StaticResource Label}" Text="Dynamic boost" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                                <Slider x:Name="DynamicBoostSlider" ui:SliderSnap.Neutral="0" ui:SliderSnap.Threshold="0.25" Grid.Column="1" Style="{StaticResource ModernSlider}" Foreground="{StaticResource AccentAudio}"

                                                        Minimum="0" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="OnSoundSliderChanged"

                                                        Margin="8,0" VerticalAlignment="Center" ToolTip="Dynamic Boost" />

                                                <TextBlock x:Name="DynamicBoostValue" Grid.Column="2" Style="{StaticResource Value}" Text="0.0" HorizontalAlignment="Right" />

                                            </Grid>



                                            <Grid Grid.Row="2" Grid.Column="0" Margin="0,0,0,7" VerticalAlignment="Center">

                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="80" />

                                                    <ColumnDefinition Width="*" />

                                                    <ColumnDefinition Width="32" />

                                                </Grid.ColumnDefinitions>

                                                <TextBlock Style="{StaticResource Label}" Text="Bass boost" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                                <Slider x:Name="BassBoostSlider" ui:SliderSnap.Neutral="0" ui:SliderSnap.Threshold="0.25" Grid.Column="1" Style="{StaticResource ModernSlider}" Foreground="{StaticResource AccentAudio}"

                                                        Minimum="0" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="OnSoundSliderChanged"

                                                        Margin="8,0" VerticalAlignment="Center" ToolTip="Bass Boost" />

                                                <TextBlock x:Name="BassBoostValue" Grid.Column="2" Style="{StaticResource Value}" Text="0.0" HorizontalAlignment="Right" />

                                            </Grid>



                                            <Grid Grid.Row="2" Grid.Column="2" Margin="0,0,0,7" VerticalAlignment="Center">

                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="80" />

                                                    <ColumnDefinition Width="*" />

                                                    <ColumnDefinition Width="32" />

                                                </Grid.ColumnDefinitions>

                                                <TextBlock Style="{StaticResource Label}" Text="Master gain" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                                <Slider x:Name="MasterGainSlider" ui:SliderSnap.Neutral="0" ui:SliderSnap.Threshold="0.3" Grid.Column="1" Style="{StaticResource ModernSliderBipolar}" Foreground="{StaticResource AccentAudio}"

                                                        Minimum="-20" Maximum="20" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="OnSoundSliderChanged"

                                                        Margin="8,0" VerticalAlignment="Center" ToolTip="Master Gain" />

                                                <TextBlock x:Name="MasterGainValue" Grid.Column="2" Style="{StaticResource Value}" Text="0.0" HorizontalAlignment="Right" />

                                            </Grid>



                                            <Grid Grid.Row="3" Grid.Column="0" Margin="0,0,0,7" VerticalAlignment="Center">

                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="80" />

                                                    <ColumnDefinition Width="*" />

                                                    <ColumnDefinition Width="32" />

                                                </Grid.ColumnDefinitions>

                                                <TextBlock Style="{StaticResource Label}" Text="Steady vol" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                                <Slider x:Name="LevelingSlider" ui:SliderSnap.Neutral="0" ui:SliderSnap.Threshold="0.15" Grid.Column="1" Style="{StaticResource ModernSlider}" Foreground="{StaticResource AccentAudio}"

                                                        Minimum="0" Maximum="4" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="OnSoundSliderChanged"

                                                        Margin="8,0" VerticalAlignment="Center" ToolTip="Volume Leveling" />

                                                <TextBlock x:Name="LevelingValue" Grid.Column="2" Style="{StaticResource Value}" Text="0.0" HorizontalAlignment="Right" />

                                            </Grid>



                                            <Grid Grid.Row="3" Grid.Column="2" Margin="0,0,0,7" VerticalAlignment="Center">

                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="80" />

                                                    <ColumnDefinition Width="*" />

                                                    <ColumnDefinition Width="32" />

                                                </Grid.ColumnDefinitions>

                                                <TextBlock Style="{StaticResource Label}" Text="Q width" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                                <Slider x:Name="FilterQSlider" ui:SliderSnap.Neutral="1.0" ui:SliderSnap.Threshold="0.04" Grid.Column="1" Style="{StaticResource ModernSlider}" Foreground="{StaticResource AccentAudio}"

                                                        Minimum="1" Maximum="3" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="OnSoundSliderChanged"

                                                        Margin="8,0" VerticalAlignment="Center" ToolTip="Q Width" />

                                                <TextBlock x:Name="FilterQValue" Grid.Column="2" Style="{StaticResource Value}" Text="0.0" HorizontalAlignment="Right" />

                                            </Grid>



                                        <!-- Nine effects in a two column grid leaves one cell
                                             over, and an empty cell beside the last row reads as
                                             something that failed to load rather than as the end of
                                             the list. So the last one spans both columns and the row
                                             reads as a deliberate full width finish. -->
                                        <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,7" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="80" />

                                                    <ColumnDefinition Width="*" />

                                                    <ColumnDefinition Width="32" />

                                                </Grid.ColumnDefinitions>

                                                <TextBlock Style="{StaticResource Label}" Text="Balance" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                                <Slider x:Name="BalanceSlider" ui:SliderSnap.Neutral="0" ui:SliderSnap.Threshold="0.3" Grid.Column="1" Style="{StaticResource ModernSliderBipolar}" Foreground="{StaticResource AccentAudio}"

                                                        Minimum="-20" Maximum="20" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="OnSoundSliderChanged"

                                                        Margin="8,0" VerticalAlignment="Center" ToolTip="Balance" />

                                                <TextBlock x:Name="BalanceValue" Grid.Column="2" Style="{StaticResource Value}" Text="0.0" HorizontalAlignment="Right" />

                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Column="1" Style="{StaticResource VHairline}" Margin="0,18" />

                                <!-- right: the equalizer, also 16:9, with the band
                                     faders filling it and scaling to the count -->
                                <Grid Grid.Column="2" Margin="0,18,0,18">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Style="{StaticResource Hero}" Padding="10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="230" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Style="{StaticResource SectionHeader}" Text="EQUALIZER" Margin="0,0,0,10" />
                                            <!-- The curve is drawn behind the faders rather
                                                 than as a row of dials of its own: it
                                                 shows the shape of the EQ at a glance, and
                                                 it costs no extra controls. -->
                                            <Border Grid.Row="1" CornerRadius="8" ClipToBounds="True" Background="#020202" Padding="4,4,4,2">
                                    <Grid>
                                        <Canvas x:Name="EqCurveCanvas" IsHitTestVisible="False" SizeChanged="OnEqCurveCanvasSizeChanged" />
                                        <UniformGrid x:Name="BandGrid" Columns="10" />
                                    </Grid>

                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="1" Margin="0,16,0,0">
                                        <!-- The label gets its own Auto column. It used to
                                             sit in a fixed 14 pixel one, which is the width
                                             of the gap in the row styles, so it was
                                             truncated to "An" and ran into the readout
                                             beside it. A fixed column is only ever right
                                             for the space between a mark and its text. -->
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Named. It was a bare switch beside a readout
                                             that described its consequence, so the only
                                             thing naming the control was a tooltip,
                                             which is no name at all for anyone not
                                             using a mouse. -->
                                        <ui:SwitchToggle x:Name="AntiClipBox" Grid.Column="0" Style="{StaticResource SwitchTrack}" Accent="{StaticResource AccentAudio}" VerticalAlignment="Center"
                                                        Checked="OnAntiClipChanged" Unchecked="OnAntiClipChanged"
                                                        ToolTip="Anti-Clip" AutomationProperties.Name="Anti-clip preamp" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource Label}" Text="Anti-clip" VerticalAlignment="Center" />
                                        <!-- The bypass takes the whole chain, not just the
                                             bands, and it is named for that.

                                             FxSound has no command to switch its processing
                                             off, so everything is sent as zero instead: the
                                             bands flat and every effect silent, which is
                                             what off has to mean when there is no off.

                                             It was labelled EQ and only flattened the bands,
                                             which left Clarity and Bass carrying on while
                                             the switch read off. A control that says off
                                             and is not off is worse than no control.

                                             It acts on its own, without Apply, because a
                                             bypass is a state rather than a setting.

                                             This cell used to hold two children directly,
                                             the readout left aligned and the switch right
                                             aligned, which only worked while both were
                                             small. "BYPASS" is a good deal wider than "EQ"
                                             and would have run into the readout, so the two
                                             now sit in columns and cannot collide. -->
                                        <Grid Grid.Column="4">
                                            <Grid.ColumnDefinitions>
                                                <!--
                                                  The readout takes what it needs and the
                                                  switches take the slack, rather than the
                                                  other way round.

                                                  This used to be a star then an auto,
                                                  so the switches grew and the readout
                                                  shrank, and "PREAMP OFF" was the thing
                                                  that got ellipsised. With a second
                                                  switch joining BYPASS it would have
                                                  been truncated more often and on more
                                                  machines. Flipping it means the
                                                  readout is never the one that pays
                                                  for whatever else is added to the row.
                                                -->
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="AntiClipValue" Grid.Column="0" Style="{StaticResource Value}" Text="PREAMP OFF"
                                                       HorizontalAlignment="Left" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                        HorizontalAlignment="Right">
                                                <ui:SwitchToggle x:Name="BypassBox" Style="{StaticResource SwitchTrack}" Accent="{StaticResource AccentAudio}"
                                                                VerticalAlignment="Center"
                                                                Checked="OnBypassChanged" Unchecked="OnBypassChanged"
                                                                ToolTip="Toggle all audio effects" AutomationProperties.Name="Bypass all audio effects" />
                                                <TextBlock Style="{StaticResource Label}" Text="BYPASS" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                <!--
                                                  Loud guard. It uses the engine's own
                                                  volume levelling rather than moving
                                                  the Windows output level, which is the
                                                  difference between a guard and a
                                                  hazard: a meter reacting to what it
                                                  measures can run away on its own, and
                                                  nothing would ever push the level
                                                  back.

                                                  It is off by default because it
                                                  changes what the sound is like rather
                                                  than correcting it, and the reset
                                                  button and the panic key deliberately
                                                  do not apply it - a guard that fought
                                                  an attempt to put things back would
                                                  be indefensible.
                                                -->
                                                <ui:SwitchToggle x:Name="LoudGuardBox" Style="{StaticResource SwitchTrack}" Accent="{StaticResource AccentAudio}"
                                                                VerticalAlignment="Center" Margin="18,0,0,0"
                                                                Checked="OnLoudGuardChanged" Unchecked="OnLoudGuardChanged"
                                                                ToolTip="Hold loud games down" AutomationProperties.Name="Hold loud games down" />
                                                <TextBlock Style="{StaticResource Label}" Text="GUARD" VerticalAlignment="Center" Margin="8,0,0,0" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Grid.Column="5" Style="{StaticResource Label}" Text="Bands" VerticalAlignment="Center" Margin="18,0,10,0" />
                                        <ComboBox x:Name="BandCountBox" Grid.Column="6" Style="{StaticResource ModernCombo}" MinWidth="68"
                                                  ItemContainerStyle="{StaticResource ModernComboItem}" SelectionChanged="OnBandCountChanged"
                                                  ToolTip="Bands" AutomationProperties.Name="Number of equalizer bands" />
                                    </Grid>

                                </Grid>
                            </Grid>

                            <!-- footer: the actions, centred, and nothing else.
                                 The old readout strip (power, loaded preset, master,
                                 steady, Q, balance, output device) was dropped
                                 because every value on it was already visible
                                 somewhere that matters: the faders show the gains,
                                 Settings shows whether the engine is running and
                                 which output is selected. -->
                            <Border Grid.Row="2" Style="{StaticResource Hairline}" VerticalAlignment="Top" Margin="18,0" />
                            <Grid Grid.Row="2" Margin="18,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Apply" Style="{StaticResource PrimaryButtonAudio}" MinWidth="116"
                                    Click="OnApplySoundClick" ToolTip="Apply" AutomationProperties.Name="Apply the sound preset" />
                                    <ui:IconButton Icon="{x:Static ui:Icons.Refresh}" Style="{StaticResource IconButton}" Margin="10,0,0,0"
                                                   Click="OnResetSoundClick" ToolTip="Reset" AutomationProperties.Name="Reset the sound to normal" />
                                    <Button x:Name="SaveToFxSoundButton" Content="Save in FxSound" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                            Click="OnSaveInFxSoundClick" ToolTip="Save in FxSound" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </TabItem>

                <!-- ================================================================
                     HOTKEYS  ·  the slot board is the hero, and the one page
                     that scrolls, on a slim dark bar
                     ================================================================ -->
                <TabItem>
                    <Border Style="{StaticResource PagePanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="54" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="18,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SlotCountText" Grid.Column="0" Style="{StaticResource SectionHeader}"
                                           Text="SLOTS" VerticalAlignment="Center" />

                                <!-- The panic key lives here rather than in the
                                     general settings, because it is a hotkey and
                                     this is where hotkeys live. It was one more
                                     row in the settings list, which is what put a
                                     scrollbar on a list that had never needed
                                     one. Keeping the two ideas apart is also why
                                     it is easier to find. -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:EmojiImage Glyph="key" Width="17" Height="17" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Panic key" VerticalAlignment="Center" Margin="0,0,8,0"
                                               FontFamily="{StaticResource Sans}" FontSize="12"
                                               Foreground="{StaticResource TextMid}" />
                                    <TextBox x:Name="PanicKeyBox" Style="{StaticResource KeyCap}"
                                             Width="112" MinWidth="112" Height="26"
                                             AutomationProperties.Name="Panic key" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:IconButton x:Name="ScanGamesButton" Icon="{x:Static ui:Icons.Search}" Style="{StaticResource IconButton}" Margin="0,0,6,0"
                                                   Click="OnScanAppsClick" ToolTip="Scan" AutomationProperties.Name="Scan this PC for games" />
                                    <ui:IconButton Icon="{x:Static ui:Icons.Plus}" Style="{StaticResource IconButton}" Margin="0,0,6,0"
                                                   Click="OnAddSlotClick" ToolTip="Add Slot" AutomationProperties.Name="Add a slot" />
                                    <ui:IconButton Icon="{x:Static ui:Icons.Refresh}" Style="{StaticResource IconButton}"
                                                   Click="OnResetSlotsClick" ToolTip="Reset Slots" AutomationProperties.Name="Reset all slots" />
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="0" Style="{StaticResource Hairline}" VerticalAlignment="Bottom" Margin="18,0" />

                            <ScrollViewer Grid.Row="1" x:Name="SlotScroll" Padding="18,16,6,0"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScroll}" />
                                </ScrollViewer.Resources>
                                <Grid x:Name="SlotList" />
                            </ScrollViewer>

                            <Border Grid.Row="2" Style="{StaticResource Hairline}" VerticalAlignment="Top" Margin="18,0" />
                            <!-- No footer row. There used to be one holding a
                                 twenty two word instruction, permanently, on
                                 every visit, explaining how to use the key box
                                 that already looks like a key and already says
                                 so on hover. It also carried a trimming rule,
                                 so at any width that did not fit it cut off
                                 mid sentence. The affordance belongs on the
                                 control, and the empty state below says the
                                 only other thing worth saying. -->
                            <TextBlock x:Name="SlotEmptyHint" Grid.Row="1" Style="{StaticResource CardSub}"
                                       Margin="18,0" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                       TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Text="Press a key box, then hold Ctrl or Alt and press the combo you want." />
                        </Grid>
                    </Border>
                </TabItem>

                <!-- ================================================================
                     SETTINGS  ·  banner on top, then one centred column
                     ================================================================ -->
                <TabItem>
                    <Border Style="{StaticResource PagePanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Height="76" Margin="18,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="{StaticResource RadiusSurface}" Background="#0E1F26"
                                        BorderBrush="{StaticResource AccentDisplay}" BorderThickness="1" VerticalAlignment="Center">
                                    <ui:EmojiImage Glyph="speaker" Width="24" Height="24" />
                                </Border>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="FxStateText" Text="MISSING" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock x:Name="FxVersionText" Margin="10,0,0,0" Style="{StaticResource CardSub}"
                                                   VerticalAlignment="Center" Text="FxSound powers every sound change in this app" />
                                    </StackPanel>
                                    <TextBlock x:Name="FxPathText" Style="{StaticResource CardSub}" Margin="0,4,0,0"
                                               FontFamily="{StaticResource Mono}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="FxInstallButton" Style="{StaticResource PrimaryButton}"
                                            MinWidth="168" Margin="0,0,8,0" Click="OnInstallClick"
                                            ToolTip="Install">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:EmojiImage Glyph="download" Width="17" Height="17" Margin="0,0,8,0" />
                                            <TextBlock Text="Install FxSound" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="FxUpgradeButton" Style="{StaticResource PrimaryButton}"
                                            MinWidth="150" Margin="0,0,8,0" Visibility="Collapsed" Click="OnUpgradeFxSoundClick"
                                            ToolTip="Check whether a newer FxSound is out">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:EmojiImage Glyph="refresh" Width="17" Height="17" Margin="0,0,8,0" />
                                            <TextBlock x:Name="FxUpgradeLabel" Text="Check update" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="FxStartEngineButton" Style="{StaticResource GhostButton}"
                                            MinWidth="128" Click="OnStartEngineClick" ToolTip="Start">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{x:Static ui:Icons.Play}" Fill="{StaticResource TextHi}" Stretch="Uniform"
                                                  Width="15" Height="15" Margin="0,0,8,0" />
                                            <TextBlock Text="Start engine" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="0" Style="{StaticResource Hairline}" VerticalAlignment="Bottom" Margin="18,0" />

                            <!-- One centred column, everything in reading order.

                                 It scrolls rather than simply being centred in the
                                 row. The option list is taller than the panel it
                                 sits in, and a centred stack that overruns its
                                 row is clipped at both ends: the first option was
                                 off the top of the view and the backup buttons off
                                 the bottom, with no way to scroll to either. The
                                 column still centres itself when it fits. -->
                            <ScrollViewer Grid.Row="1" x:Name="SettingsScroll" Padding="0,14,0,14"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScroll}" />
                                </ScrollViewer.Resources>
                                <!-- One centred list, and everything on it is a row
                                     of the same shape: an emoji, a label, and
                                     whatever belongs on the right. The sound out
                                     picker and the backup pair are rows like the
                                     switches are, not sections of their own, which
                                     is what keeps the page to one column and
                                     inside the panel without a scrollbar. -->
                            <!-- One centred list, and everything on it is a row
                                 of the same shape: an emoji, a label, and
                                 whatever belongs on the right. The sound out
                                 picker and the backup pair are rows like the
                                 switches are, not sections of their own, which
                                 is what keeps the page to one column and
                                 inside the panel without a scrollbar.

                                 MaxWidth rather than a fixed Width, and Top rather
                                 than Centre. A fixed width with Centre alignment
                                 is what put this list in the middle of the page
                                 while the banner above it sat hard against the
                                 left margin, so the tab had three different left
                                 edges on it. And a centred column that is taller
                                 than the viewport has its overflow off both ends
                                 with no way to scroll to it, which is how the
                                 SETTINGS heading ended up sliced in half by the
                                 hairline above it and the last two switches ended
                                 up unreachable. Top lets the scroll viewer do the
                                 centring when the list fits and simply scroll when
                                 it does not. -->
                            <StackPanel MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="18,0">

                                <!-- No "SETTINGS" header over this list any more.

                                     It named the page, and the nav pill above
                                     already names the page, in the same accent,
                                     one row higher, with the other three names
                                     beside it. A second copy of the same word
                                     is the one piece of the tab that was saying
                                     nothing, and it was saying it in the most
                                     expensive way available: about twenty six
                                     pixels of a list that had roughly seventy to
                                     give and thirteen rows to spend them on.

                                     That margin is what the night schedule's row
                                     was short of. The header goes rather than the
                                     row does, because the header was a label for
                                     the page and the row is a setting. -->
                                <!-- The whole list is one list now. It used to be ruled
                                     into four blocks by three hairlines, on the
                                     reasoning that a rule belongs where one kind of
                                     row gives way to another. In practice the rules
                                     were carrying no information: the rows they
                                     separated were already the same height, already
                                     had their own hover plate, and the only thing
                                     the eye read off them was "something structural
                                     is happening here" that nothing then explained.
                                     A switch, a clipboard row, a device picker and
                                     a pair of buttons are all one decision each,
                                     and they now sit in a single evenly spaced
                                     column.

                                     The spacing is on the OptionRow and ActionRow
                                     styles rather than on the rows, so every row is
                                     spaced the same by construction instead of by
                                     remembering to set it. -->
                                <ui:OptionToggle x:Name="HardwareBrightnessBox" Style="{StaticResource OptionRow}"
                                                 Glyph="sun" Label="Hardware brightness (DDC/CI)"
                                                 Checked="OnOptionChanged" Unchecked="OnOptionChanged"
                                                 BadgeClick="OnHardwareBrightnessWhy"
                                                 BadgeToolTip="Why was this turned off?"
                                                 ToolTip="Controls the monitor's own backlight over DDC/CI instead of only bending gamma. Off by default: it talks to the monitor over I2C, which on a small number of displays with broken firmware has been known to crash Windows itself. The software controls are unaffected either way. If a display ever ends up stuck dim after a crash, or after ending Gamer Tool with End task in Task Manager, the brightness is still under the monitor's own menu controls - the app cannot put it back, because a forced kill runs none of its code." />
                                <!--
                                  No row of prose under this switch.

                                  Both earlier attempts put text there: a paragraph
                                  first, then a one line nudge with a Why? link.
                                  Both cost more than they were worth. The nudge
                                  still occupied a row in the middle of a list of
                                  switches, it started a scrollbar on a tab that
                                  had never needed one, and "Turned off
                                  automatically" is a thing the info badge
                                  underneath already says on its own row.

                                  So the explanation is a glyph, on the same row as
                                  the switch, and the detail is one click away in a
                                  dialog. The switch it belongs to is labelled in
                                  plain English right beside it, and the whole row
                                  already carries a tooltip saying what it does.

                                  The badge is set from code, because whether it is
                                  there at all depends on the probe, and the wording
                                  of its tooltip lives with the policy that decides
                                  it. The glyph itself is drawn by the OptionRow
                                  template, which collapses the badge and its
                                  column when the glyph is empty, so a row without
                                  one looks exactly as it did before.
                                -->
                                <ui:OptionToggle x:Name="GammaLockBox" Style="{StaticResource OptionRow}"
                                                 Glyph="lock" Label="Keep screen locked"
                                                 Checked="OnOptionChanged" Unchecked="OnOptionChanged"
                                                 ToolTip="Gamma Lock" />
                                <!-- Night blue light.

                                     One row rather than a switch and a row of times,
                                     because the Settings list has about seventy
                                     pixels of slack left in a 790 tall window and
                                     two rows is about ninety six. Putting the
                                     schedule under the blue light filter it
                                     changes would be more discoverable, but that
                                     dropdown sits on the Display tab beside a
                                     tuning surface, where "what to load now" is
                                     what everything else on the tab is about, and
                                     a thing that fires at eight in the evening
                                     with no game involved is a different kind of
                                     decision from that.

                                     So it lives here, next to the other screen
                                     behaviour, and the two times are on the same
                                     row as the switch because the schedule is
                                     one decision with three parts rather than
                                     three decisions.

                                     The pickers are a whole hour apart and say
                                     "8 PM" and "7 AM" rather than 20:00 and
                                     07:00. This is read at a glance in the
                                     evening by somebody deciding when to go to
                                     bed, and on a twenty four hour clock the one
                                     that matters is the larger number. It is also
                                     twenty four entries rather than ninety six,
                                     which fits on a screen without a scrollbar.
                                     They grey out with the switch off, which is
                                     the honest way to say the hours are not
                                     being used rather than leaving them looking
                                     live. -->
                                <Border x:Name="NightRow" Style="{StaticResource ActionRow}"
                                        ToolTip="Puts the blue light filter on by itself between these hours, and takes it back off at the end. It is the app's own filter, not Windows Night Light. A game that loads its own slot is unaffected: the schedule changes the filter, not the tune.">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ui:EmojiImage Grid.Column="0" Glyph="moon" Width="19" Height="19" VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="2" Text="Night blue light" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource Sans}" FontSize="12"
                                                   Foreground="{StaticResource TextHi}" TextTrimming="CharacterEllipsis" />

                                        <Grid Grid.Column="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="92" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="92" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ComboBox x:Name="NightStartBox" Grid.Column="0" Style="{StaticResource ModernCombo}"
                                                      ItemContainerStyle="{StaticResource ModernComboItem}" SelectionChanged="OnNightTimeChanged"
                                                      VerticalAlignment="Center" ToolTip="From"
                                                      AutomationProperties.Name="Night blue light from" />
                                            <TextBlock Grid.Column="2" Text="to" VerticalAlignment="Center" Margin="0,0,0,-1"
                                                       FontFamily="{StaticResource Sans}" FontSize="12" Foreground="{StaticResource TextMid}" />
                                            <ComboBox x:Name="NightEndBox" Grid.Column="4" Style="{StaticResource ModernCombo}"
                                                      ItemContainerStyle="{StaticResource ModernComboItem}" SelectionChanged="OnNightTimeChanged"
                                                      VerticalAlignment="Center" ToolTip="Until"
                                                      AutomationProperties.Name="Night blue light until" />
                                            <ui:SwitchToggle x:Name="NightBox" Grid.Column="6" Style="{StaticResource SwitchTrack}"
                                                             Accent="{StaticResource AccentSettings}" VerticalAlignment="Center"
                                                             Checked="OnNightScheduleChanged" Unchecked="OnNightScheduleChanged"
                                                             ToolTip="Night blue light" AutomationProperties.Name="Night blue light schedule" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <ui:OptionToggle x:Name="OsdBox" Style="{StaticResource OptionRow}"
                                                 Glyph="chat" Label="In-game popup"
                                                 Checked="OnOptionChanged" Unchecked="OnOptionChanged"
                                                 ToolTip="Show Popup" />
                                <ui:OptionToggle x:Name="AutoSwitchBox" Style="{StaticResource OptionRow}"
                                                 Glyph="gamepad" Label="Auto load slots by game"
                                                 Checked="OnOptionChanged" Unchecked="OnOptionChanged"
                                                 ToolTip="Auto Switch" />
                                <ui:OptionToggle x:Name="AutoRevertBox" Style="{StaticResource OptionRow}"
                                                 Glyph="refresh" Label="Auto-revert on game exit"
                                                 Checked="OnOptionChanged" Unchecked="OnOptionChanged"
                                                 ToolTip="Auto Revert" />
                                <ui:OptionToggle x:Name="CloseToTrayBox" Style="{StaticResource OptionRow}"
                                                 Glyph="folder" Label="Close to tray"
                                                 Checked="OnOptionChanged" Unchecked="OnOptionChanged"
                                                 ToolTip="Close to Tray" />
                                <ui:OptionToggle x:Name="StartHiddenBox" Style="{StaticResource OptionRow}"
                                                 Glyph="hide" Label="Start hidden in tray"
                                                 Checked="OnOptionChanged" Unchecked="OnOptionChanged"
                                                 ToolTip="Start Hidden" />
                                <ui:OptionToggle x:Name="StartWithWindowsBox" Style="{StaticResource OptionRow}"
                                                 Glyph="rocket" Label="Start with Windows"
                                                 Checked="OnStartupOptionChanged" Unchecked="OnStartupOptionChanged"
                                                 ToolTip="Start with Windows" />
                                <ui:OptionToggle x:Name="FxPromptBox" Style="{StaticResource OptionRow}"
                                                 Glyph="warning" Label="Don't ask about FxSound"
                                                 Checked="OnOptionChanged" Unchecked="OnOptionChanged"
                                                 ToolTip="Stop Prompting" />

                                                <!-- Diagnostics sits in the options list as one of
                                                     them rather than in a block of its own. It is
                                                     the only row here that is not a setting, and
                                                     it keeps the list's metrics anyway: same
                                                     height, same 19 pixel mark, same label, so
                                                     there is nothing to signal that it is a
                                                     different kind of row.

                                                     What sits where a switch would be is a
                                                     clipboard mark, because that is the whole
                                                     action. The row is still one line, so there is
                                                     nowhere else for a confirmation to go except
                                                     in the space the mark was in. -->

                                <Border x:Name="DiagRow" Style="{StaticResource ActionRow}" Cursor="Hand"
                                        MouseLeftButtonUp="OnCopyDiagnosticsClick"
                                        ToolTip="Click to copy the log">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="34" />
                                        </Grid.ColumnDefinitions>

                                        <ui:EmojiImage Grid.Column="0" Glyph="bug" Width="19" Height="19" VerticalAlignment="Center" />

                                        <TextBlock x:Name="DiagLabelText" Grid.Column="2" Text="Diagnostics" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource Sans}" FontSize="12"
                                                   Foreground="{StaticResource TextHi}" TextTrimming="CharacterEllipsis" />

                                        <!-- The confirmation gets a column of its own, sitting
                                             between the label and the mark, and the mark
                                             stays put.

                                             Both used to be in the switch's 34 pixel
                                             slot, with the text right aligned in it and
                                             the clipboard hidden for the two and a half
                                             seconds the confirmation was up. "Copied to
                                             clipboard" is about a hundred pixels of
                                             text, so in a 34 pixel slot it was cut
                                             off at the first few letters, and the row
                                             had lost the thing the user had just
                                             clicked. The mark is what identifies the
                                             action, so hiding it to make room for
                                             the news that the action worked was
                                             backwards.

                                             The label column is the star, so this
                                             column is taken out of it when it appears
                                             and given back when it goes. The mark is
                                             the last column and stays pinned to the
                                             row's right edge either way, which is
                                             what keeps the row lined up with the
                                             switches above it. -->

                                        <TextBlock x:Name="DiagCopiedText" Grid.Column="3"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                                   FontFamily="{StaticResource Sans}" FontSize="11" FontWeight="SemiBold"
                                                   Visibility="Collapsed" TextTrimming="CharacterEllipsis" />

                                        <!-- A fixed 34 rather than Auto, because that is
                                             the width of the switch track and the row
                                             has to read as one of the toggles. Sized
                                             to its content the row changed width every
                                             time the confirmation appeared, shoving
                                             the mark in and out.

                                             The column is stated explicitly. Left to
                                             default it falls into column zero, on top
                                             of the ladybug, which is what a build
                                             did once. -->

                                        <Button x:Name="CopyDiagButton" Grid.Column="5"
                                                Style="{StaticResource GhostButton}"
                                                Width="34" Height="30" MinWidth="0" Padding="0"
                                                HorizontalAlignment="Right"
                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                Click="OnCopyDiagnosticsClick"
                                                ToolTip="Copy the log to the clipboard"
                                                AutomationProperties.Name="Copy diagnostics">
                                            <ui:EmojiImage Glyph="clipboard" Width="19" Height="19" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource ActionRow}" ToolTip="Where sound is sent. Rescan looks for devices that were plugged in after the app started.">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ui:EmojiImage Grid.Column="0" Glyph="speaker" Width="19" Height="19" VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="2" Text="Sound out" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource Sans}" FontSize="12"
                                                   Foreground="{StaticResource TextHi}" />

                                        <Grid Grid.Column="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="DeviceBox" Grid.Column="0" Style="{StaticResource ModernCombo}"
                                                      ItemContainerStyle="{StaticResource ModernComboItem}" SelectionChanged="OnDeviceSelected"
                                                      ToolTip="Output Device" VerticalAlignment="Center" />
                                            <ui:IconButton Grid.Column="2" Icon="{x:Static ui:Icons.Refresh}" Style="{StaticResource IconButton}"
                                                           VerticalAlignment="Center"
                                                           Click="OnRescanDevicesClick" ToolTip="Rescan" AutomationProperties.Name="Rescan sound outputs" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource ActionRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ui:EmojiImage Grid.Column="0" Glyph="download" Width="19" Height="19" VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="2" Text="Backup and restore" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource Sans}" FontSize="12"
                                                   Foreground="{StaticResource TextHi}" />

                                        <Grid Grid.Column="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Style="{StaticResource PrimaryButton}" MinWidth="118" Click="OnBackupClick"
                                                    ToolTip="Write a backup file">
                                                <StackPanel Orientation="Horizontal">
                                                    <Viewbox Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center">
                                                        <Path Data="{x:Static ui:Icons.Save}" Stroke="#EAFBF7" StrokeThickness="1.7"
                                                              StrokeLineJoin="Round" Fill="Transparent" />
                                                    </Viewbox>
                                                    <TextBlock Text="Backup" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" MinWidth="118" Click="OnRestoreClick"
                                                    ToolTip="Read a backup file back">
                                                <StackPanel Orientation="Horizontal">
                                                    <Viewbox Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center">
                                                        <Path Data="{x:Static ui:Icons.Restore}" Stroke="{StaticResource TextMid}" StrokeThickness="1.7"
                                                              StrokeLineJoin="Round" Fill="Transparent" />
                                                    </Viewbox>
                                                    <TextBlock Text="Restore" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- What the last backup or restore actually did. Indented
                                     to the label rather than to the row, and collapsed
                                     until there is something to say: an empty caption
                                     left permanently open is a 44 pixel hole in the
                                     middle of the list, which is most of what was
                                     pushing the page past the panel. -->
                                <StackPanel x:Name="BackupDetailRow" Margin="37,7,8,0" Visibility="Collapsed">
                                    <TextBlock x:Name="BackupHintText" Style="{StaticResource CardSub}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="BackupNoteText" Style="{StaticResource CardSub}" Margin="0,3,0,0"
                                               TextWrapping="Wrap" MaxHeight="60" />
                                </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- ============ STATUS BAR ============ -->
        <Border Grid.Row="2" Style="{StaticResource StatusBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{StaticResource Green}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="RailStatus" Text="READY" FontSize="10.5" Foreground="{StaticResource TextMid}" VerticalAlignment="Center" />
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
        </Border>
</Window>




