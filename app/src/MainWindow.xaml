    <Window x:Class="GamerTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GamerTool.ViewModels"
        Title="Gamer Tool"
        Width="1040" MinWidth="900" MaxWidth="1400"
        Height="640" MinHeight="580" MaxHeight="900"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="False"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <!-- ===================== TITLE BAR ===================== -->
        <Grid Grid.Row="0" Background="{StaticResource CardBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="GAMER TOOL" Foreground="{DynamicResource AccentBrush}"
                       FontFamily="Segoe UI Variable, Segoe UI" FontWeight="Bold" FontSize="12"
                       VerticalAlignment="Center" Margin="14,0,0,0"/>
            <Button Grid.Column="1" Content="_" Style="{StaticResource TitleBarGlyphButtonStyle}" Click="MinimizeButton_Click"/>
            <Button Grid.Column="2" Content="&#x2715;" Style="{StaticResource TitleBarCloseButtonStyle}" Click="CloseButton_Click"/>
        </Grid>

        <!-- ===================== BODY: SIDEBAR + CONTENT ===================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===================== SIDEBAR ===================== -->
            <Border Grid.Column="0" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Brand mark -->
                    <Border Grid.Row="0" Style="{StaticResource BrandMarkStyle}" Margin="0,16,0,18">
                        <TextBlock Text="GT" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Nav rail -->
                    <StackPanel Grid.Row="1">
                        <Button x:Name="TabDisplay" Tag="#FF00E676"
                                Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppTab.Display}"
                                ToolTip="Display presets">
                            <StackPanel>
                                <TextBlock Text="&#x1F5A5;" FontSize="18" HorizontalAlignment="Center"/>
                                <TextBlock Text="DISPLAY" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentTab}" Value="{x:Static vm:AppTab.Display}">
                                            <Setter Property="Foreground" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
                                            <Setter Property="Background" Value="{DynamicResource AccentDimBrush}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Grid Background="{TemplateBinding Background}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="3"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Background="{TemplateBinding Foreground}"/>
                                                            <ContentPresenter Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="TabAudio" Tag="#FF00B0FF"
                                Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppTab.Audio}"
                                ToolTip="Audio EQ presets">
                            <StackPanel>
                                <TextBlock Text="&#x1F3A7;" FontSize="18" HorizontalAlignment="Center"/>
                                <TextBlock Text="AUDIO" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentTab}" Value="{x:Static vm:AppTab.Audio}">
                                            <Setter Property="Foreground" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
                                            <Setter Property="Background" Value="{DynamicResource AccentDimBrush}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Grid Background="{TemplateBinding Background}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="3"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Background="{TemplateBinding Foreground}"/>
                                                            <ContentPresenter Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="TabCombos" Tag="#FFFFC400"
                                Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppTab.Combos}"
                                ToolTip="Combos (one hotkey, two presets)">
                            <StackPanel>
                                <TextBlock Text="&#x26A1;" FontSize="18" HorizontalAlignment="Center"/>
                                <TextBlock Text="COMBOS" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentTab}" Value="{x:Static vm:AppTab.Combos}">
                                            <Setter Property="Foreground" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
                                            <Setter Property="Background" Value="{DynamicResource AccentDimBrush}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Grid Background="{TemplateBinding Background}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="3"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Background="{TemplateBinding Foreground}"/>
                                                            <ContentPresenter Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="TabSettings" Tag="#FFB388FF"
                                Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppTab.Settings}"
                                ToolTip="Settings">
                            <StackPanel>
                                <TextBlock Text="&#x2699;" FontSize="18" HorizontalAlignment="Center"/>
                                <TextBlock Text="SETTINGS" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentTab}" Value="{x:Static vm:AppTab.Settings}">
                                            <Setter Property="Foreground" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
                                            <Setter Property="Background" Value="{DynamicResource AccentDimBrush}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Grid Background="{TemplateBinding Background}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="3"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Background="{TemplateBinding Foreground}"/>
                                                            <ContentPresenter Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Emergency reset - always one click away, from any tab -->
                    <Button Grid.Row="3" Style="{StaticResource GlyphButtonStyle}" Margin="0,0,0,14"
                            Command="{Binding PanicResetCommand}" Foreground="{StaticResource DangerRedBrush}"
                            ToolTip="Emergency reset - factory display &amp; flat EQ (Ctrl+Alt+R)"
                            HorizontalAlignment="Center">
                        <TextBlock Text="&#x21BA;" FontSize="17"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ===================== CONTENT ===================== -->
            <Grid Grid.Column="1" Margin="24,18,24,12">

                <!-- ===================== DISPLAY TAB ===================== -->
                <Grid x:Name="DisplayTabContent">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="{x:Static vm:AppTab.Display}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Preset cycler -->
                    <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource CardBorderStyle}" Padding="10,8" Margin="0,0,0,12"
                            HorizontalAlignment="Center" Width="420">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="&#x25C0;" Style="{StaticResource GlyphButtonStyle}"
                                    Command="{Binding CycleDisplayPresetBackCommand}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Vertical">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Image Source="{Binding SelectedDisplayPreset.Icon, Converter={StaticResource IconKeyToImageConverter}, Mode=OneWay}"
                                           Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding SelectedDisplayPreset.Name, Mode=OneWay}"
                                               Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="16"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedDisplayPreset.HotkeyDisplayLabel, Mode=OneWay, TargetNullValue='No hotkey'}"
                                           Style="{StaticResource BodyTextStyle}" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="&#x25B6;" Style="{StaticResource GlyphButtonStyle}"
                                    Command="{Binding CycleDisplayPresetForwardCommand}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Live preview -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0" HorizontalAlignment="Center">
                        <TextBlock Text="LIVE PREVIEW" Style="{StaticResource HeaderTextStyle}" HorizontalAlignment="Center"/>
                        <Border Style="{StaticResource CardBorderStyle}" Padding="4" Margin="0,0,0,6">
                            <Image x:Name="PreviewImage" Width="360" Height="203" Stretch="Uniform" SnapsToDevicePixels="True"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Apply to Screen" Style="{StaticResource NeonButtonStyle}" Padding="12,5"
                                    Command="{Binding ApplyDisplayToScreenCommand}" Margin="0,0,6,0"/>
                            <Button Content="Hotkey" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding RecordSelectedDisplayHotkeyCommand}" Margin="0,0,6,0"/>
                            <Button Content="Compare" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5"
                                    ToolTip="Hold to preview the factory look"
                                    PreviewMouseLeftButtonDown="CompareButton_PreviewMouseDown"
                                    PreviewMouseLeftButtonUp="CompareButton_PreviewMouseUp" Margin="0,0,6,0"/>
                            <Button Content="&#x22EF;" Style="{StaticResource OverflowButtonStyle}" Click="OverflowButton_Click">
                                <Button.ContextMenu>
                                    <ContextMenu Style="{StaticResource DarkContextMenuStyle}">
                                        <MenuItem Header="Rename..." Style="{StaticResource DarkMenuItemStyle}"
                                                  Command="{Binding RenameDisplayPresetCommand}"
                                                  Visibility="{Binding SelectedDisplayPreset.IsBuiltIn, Converter={StaticResource InverseBoolToVisConverter}}"/>
                                        <MenuItem Header="Duplicate" Style="{StaticResource DarkMenuItemStyle}"
                                                  Command="{Binding DuplicateDisplayPresetCommand}"/>
                                        <MenuItem Header="Toggle Favorite ★" Style="{StaticResource DarkMenuItemStyle}"
                                                  Command="{Binding ToggleDisplayFavoriteCommand}"/>
                                        <MenuItem Header="Clear Hotkey" Style="{StaticResource DarkMenuItemStyle}"
                                                  Command="{Binding ClearDisplayHotkeyCommand}"/>
                                        <Separator Style="{StaticResource DarkSeparatorStyle}"
                                                   Visibility="{Binding SelectedDisplayPreset.IsBuiltIn, Converter={StaticResource InverseBoolToVisConverter}}"/>
                                        <MenuItem Header="Delete" Style="{StaticResource DarkDangerMenuItemStyle}"
                                                  Command="{Binding DeleteDisplayPresetCommand}"
                                                  Visibility="{Binding SelectedDisplayPreset.IsBuiltIn, Converter={StaticResource InverseBoolToVisConverter}}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <CheckBox Content="Live apply" IsChecked="{Binding IsDisplayLive, Mode=TwoWay}"
                                      Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="Primary monitor only" Style="{StaticResource BodyTextStyle}" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Adjustments -->
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="0,26,0,0">
                        <StackPanel>
                            <TextBlock Text="ADJUSTMENTS" Style="{StaticResource HeaderTextStyle}"/>

                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="38"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Gamma" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Style="{StaticResource GlowSliderStyle}" Minimum="0.5" Maximum="3.0" Value="{Binding Gamma, Mode=TwoWay}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Gamma, StringFormat={}{0:0.00}}" Style="{StaticResource ValueTextStyle}" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="38"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Contrast" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Style="{StaticResource GlowSliderStyle}" Minimum="0.5" Maximum="2.0" Value="{Binding Contrast, Mode=TwoWay}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Contrast, StringFormat={}{0:0.00}}" Style="{StaticResource ValueTextStyle}" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="38"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Shadows" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Style="{StaticResource GlowSliderStyle}" Minimum="0.0" Maximum="0.5" Value="{Binding ShadowLift, Mode=TwoWay}"/>
                                <TextBlock Grid.Column="2" Text="{Binding ShadowLift, StringFormat={}{0:0.00}}" Style="{StaticResource ValueTextStyle}" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="38"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Brightness" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Style="{StaticResource GlowSliderStyle}" Minimum="-0.25" Maximum="0.25" Value="{Binding BrightnessOffset, Mode=TwoWay}"/>
                                <TextBlock Grid.Column="2" Text="{Binding BrightnessOffset, StringFormat={}{0:0.00}}" Style="{StaticResource ValueTextStyle}" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="38"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Red Gain" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Style="{StaticResource GlowSliderStyle}" Minimum="0.0" Maximum="1.5" Value="{Binding GainRed, Mode=TwoWay}"/>
                                <TextBlock Grid.Column="2" Text="{Binding GainRed, StringFormat={}{0:0.00}}" Style="{StaticResource ValueTextStyle}" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="38"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Green Gain" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Style="{StaticResource GlowSliderStyle}" Minimum="0.0" Maximum="1.5" Value="{Binding GainGreen, Mode=TwoWay}"/>
                                <TextBlock Grid.Column="2" Text="{Binding GainGreen, StringFormat={}{0:0.00}}" Style="{StaticResource ValueTextStyle}" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="38"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Blue Gain" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Style="{StaticResource GlowSliderStyle}" Minimum="0.0" Maximum="1.5" Value="{Binding GainBlue, Mode=TwoWay}"/>
                                <TextBlock Grid.Column="2" Text="{Binding GainBlue, StringFormat={}{0:0.00}}" Style="{StaticResource ValueTextStyle}" VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0"
                                        Visibility="{Binding IsDisplayDirty, Converter={StaticResource BoolToVisConverter}}">
                                <Button Content="Save As New" Style="{StaticResource NeonButtonStyle}"
                                        Command="{Binding SaveDisplayPresetCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===================== AUDIO TAB ===================== -->
                <Grid x:Name="AudioTabContent">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="{x:Static vm:AppTab.Audio}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" Width="420">
                    <Border Style="{StaticResource CardBorderStyle}" BorderBrush="#FFFFB74D" BorderThickness="1"
                            Padding="10,8" Margin="0,0,0,8"
                            Visibility="{Binding IsEqEngineEnabled, Converter={StaticResource InverseBoolToVisConverter}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#x1F507;" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" TextWrapping="Wrap" Width="240"
                                       Text="EQ engine off - sliders move but you hear nothing."/>
                            <Button Content="Enable" Style="{StaticResource NeonButtonStyle}" Padding="12,4" Margin="8,0,0,0"
                                    Command="{Binding EnableEqEngineCommand}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" BorderBrush="#FFFFB74D" BorderThickness="1"
                            Padding="10,8" Margin="0,0,0,8"
                            Visibility="{Binding NeedsEqReattach, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#x1F3A7;" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" TextWrapping="Wrap" Width="240"
                                       Text="New audio device? Re-run Enable so it gets wired."/>
                            <Button Content="Re-run Enable" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="8,0,0,0"
                                    Command="{Binding EnableEqEngineCommand}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="10,8" Margin="0,0,0,12"
                            HorizontalAlignment="Center" Width="420">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="&#x25C0;" Style="{StaticResource GlyphButtonStyle}"
                                    Command="{Binding CycleAudioPresetBackCommand}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Vertical">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Image Source="{Binding SelectedAudioPreset.Icon, Converter={StaticResource IconKeyToImageConverter}, Mode=OneWay}"
                                           Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding SelectedAudioPreset.Name, Mode=OneWay}"
                                               Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="16"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedAudioPreset.HotkeyDisplayLabel, Mode=OneWay, TargetNullValue='No hotkey'}"
                                           Style="{StaticResource BodyTextStyle}" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="&#x25B6;" Style="{StaticResource GlyphButtonStyle}"
                                    Command="{Binding CycleAudioPresetForwardCommand}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    </StackPanel>

                    <!-- EQ curve preview + test loop -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0" HorizontalAlignment="Center">
                        <TextBlock Text="RESPONSE" Style="{StaticResource HeaderTextStyle}" HorizontalAlignment="Center"/>
                        <Border Style="{StaticResource CardBorderStyle}" Padding="4" Margin="0,0,0,6">
                            <Image x:Name="EqCurveImage" Width="360" Height="203" Stretch="Uniform" SnapsToDevicePixels="True"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="TestAudioButton" Content="&#x25B6;  Play Test" Style="{StaticResource NeonButtonStyle}"
                                    Padding="12,5" Click="TestAudioButton_Click" Margin="0,0,6,0"/>
                            <Button Content="Hotkey" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding RecordSelectedAudioHotkeyCommand}" Margin="0,0,6,0"/>
                            <Button Content="&#x22EF;" Style="{StaticResource OverflowButtonStyle}" Click="OverflowButton_Click">
                                <Button.ContextMenu>
                                    <ContextMenu Style="{StaticResource DarkContextMenuStyle}">
                                        <MenuItem Header="Rename..." Style="{StaticResource DarkMenuItemStyle}"
                                                  Command="{Binding RenameAudioPresetCommand}"
                                                  Visibility="{Binding SelectedAudioPreset.IsBuiltIn, Converter={StaticResource InverseBoolToVisConverter}}"/>
                                        <MenuItem Header="Duplicate" Style="{StaticResource DarkMenuItemStyle}"
                                                  Command="{Binding DuplicateAudioPresetCommand}"/>
                                        <MenuItem Header="Toggle Favorite ★" Style="{StaticResource DarkMenuItemStyle}"
                                                  Command="{Binding ToggleAudioFavoriteCommand}"/>
                                        <MenuItem Header="Clear Hotkey" Style="{StaticResource DarkMenuItemStyle}"
                                                  Command="{Binding ClearAudioHotkeyCommand}"/>
                                        <Separator Style="{StaticResource DarkSeparatorStyle}"
                                                   Visibility="{Binding SelectedAudioPreset.IsBuiltIn, Converter={StaticResource InverseBoolToVisConverter}}"/>
                                        <MenuItem Header="Delete" Style="{StaticResource DarkDangerMenuItemStyle}"
                                                  Command="{Binding DeleteAudioPresetCommand}"
                                                  Visibility="{Binding SelectedAudioPreset.IsBuiltIn, Converter={StaticResource InverseBoolToVisConverter}}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <CheckBox Content="Bypass EQ" IsChecked="{Binding IsAudioBypassed, Mode=TwoWay}"
                                      Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <CheckBox Content="Loudness" IsChecked="{Binding EnableNativeLoudness, Mode=TwoWay}"
                                      Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center"
                                      ToolTip="Windows Loudness Equalization (dialogue compression)"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 10-band EQ -->
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="0,26,0,0">
                        <StackPanel>
                            <TextBlock Text="EQUALIZER" Style="{StaticResource HeaderTextStyle}"/>
                            <ItemsControl ItemsSource="{Binding BandGains}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" Columns="10" Height="150"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="{Binding GainDb, StringFormat={}{0:+0.0;-0.0;0.0}}"
                                                       HorizontalAlignment="Center" FontSize="9" Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas"/>

                                            <Slider Grid.Row="1" Style="{StaticResource VerticalGlowSliderStyle}" Minimum="-12" Maximum="12"
                                                    Value="{Binding GainDb, Mode=TwoWay}" VerticalAlignment="Stretch" HorizontalAlignment="Center" Margin="0,6,0,4"/>

                                            <TextBlock Grid.Row="2" Text="{Binding FrequencyLabel}" HorizontalAlignment="Center"
                                                       FontSize="9" Foreground="{StaticResource MutedTextBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0"
                                        Visibility="{Binding IsAudioDirty, Converter={StaticResource BoolToVisConverter}}">
                                <Button Content="Save As New" Style="{StaticResource NeonButtonStyle}"
                                        Command="{Binding SaveAudioPresetCommand}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource BodyTextStyle}" FontSize="10" TextAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="Built-in anti-clip: loud boosts are auto-leveled (turn up volume to compensate)."/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===================== COMBOS TAB ===================== -->
                <Grid x:Name="CombosTabContent">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="{x:Static vm:AppTab.Combos}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Create combo -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" HorizontalAlignment="Stretch">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                                <TextBlock Text="Name" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,3"/>
                                <TextBox Style="{StaticResource DarkTextBoxStyle}" Text="{Binding NewComboName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                <TextBlock Text="Display" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,3"/>
                                <ComboBox Style="{StaticResource DarkComboBoxStyle}" ItemsSource="{Binding DisplayPresets}" DisplayMemberPath="Name"
                                          SelectedItem="{Binding NewComboDisplayPreset, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4" VerticalAlignment="Top">
                                <TextBlock Text="Audio" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,3"/>
                                <ComboBox Style="{StaticResource DarkComboBoxStyle}" ItemsSource="{Binding AudioPresets}" DisplayMemberPath="Name"
                                          SelectedItem="{Binding NewComboAudioPreset, Mode=TwoWay}"/>
                            </StackPanel>
                            <Button Grid.Column="6" Content="Create" Style="{StaticResource NeonButtonStyle}"
                                    VerticalAlignment="Bottom" Command="{Binding CreateComboCommand}"/>
                        </Grid>
                    </Border>

                    <!-- Existing combos: HORIZONTAL strip only - no vertical scrolling, ever. -->
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <!-- Empty state -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Width="420">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ComboPresets.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="&#x26A1;" FontSize="26" HorizontalAlignment="Left"/>
                                <TextBlock Text="No combos yet" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,4,0,0"
                                           Text="Pair a Display preset with an Audio preset above for one-hotkey switching. Try: Night Eye + Footsteps."/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto"
                                      VerticalAlignment="Top" PanningMode="HorizontalOnly">
                            <ItemsControl ItemsSource="{Binding ComboPresets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ComboCardBorderStyle}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{Binding Icon, Converter={StaticResource IconKeyToImageConverter}, Mode=OneWay}"
                                                           Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource PrimaryTextBrush}"
                                                               FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource BodyTextStyle}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap">
                                                    <Run Text="{Binding DisplayPresetName, Mode=OneWay}"/>
                                                    <Run Text=" + "/>
                                                    <Run Text="{Binding AudioPresetName, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding HotkeyDisplayLabel, Mode=OneWay, TargetNullValue='No hotkey'}"
                                                           Style="{StaticResource BodyTextStyle}" FontSize="10" Margin="0,4,0,8"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Activate" Style="{StaticResource NeonButtonStyle}" Padding="10,4" FontSize="10"
                                                            Command="{Binding DataContext.ActivateComboCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" Margin="0,0,4,0"/>
                                                    <Button Content="&#x22EF;" Style="{StaticResource OverflowButtonStyle}" Click="OverflowButton_Click">
                                                        <Button.ContextMenu>
                                                            <ContextMenu Style="{StaticResource DarkContextMenuStyle}">
                                                                <MenuItem Header="Set Hotkey..." Style="{StaticResource DarkMenuItemStyle}"
                                                                          Command="{Binding DataContext.RecordComboHotkeyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          CommandParameter="{Binding}"/>
                                                                <MenuItem Header="Toggle Favorite ★" Style="{StaticResource DarkMenuItemStyle}"
                                                                          Command="{Binding DataContext.ToggleComboFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          CommandParameter="{Binding}"/>
                                                                <MenuItem Header="Duplicate" Style="{StaticResource DarkMenuItemStyle}"
                                                                          Command="{Binding DataContext.DuplicateComboCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          CommandParameter="{Binding}"/>
                                                                <MenuItem Header="Clear Hotkey" Style="{StaticResource DarkMenuItemStyle}"
                                                                          Command="{Binding DataContext.ClearComboHotkeyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          CommandParameter="{Binding}"/>
                                                                <Separator Style="{StaticResource DarkSeparatorStyle}"/>
                                                                <MenuItem Header="Delete" Style="{StaticResource DarkDangerMenuItemStyle}"
                                                                          Command="{Binding DataContext.DeleteComboCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          CommandParameter="{Binding}"/>
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- ===================== SETTINGS TAB (2-column, fits without scrolling) ===================== -->
                <Grid x:Name="SettingsTabContent">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="{x:Static vm:AppTab.Settings}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left column -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Top">
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="GENERAL" Style="{StaticResource HeaderTextStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Run on Windows Startup" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding RunOnStartup, Mode=TwoWay}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" BorderBrush="{StaticResource DangerRedBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="DANGER ZONE" Style="{StaticResource HeaderTextStyle}" Foreground="{StaticResource DangerRedBrush}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource BodyTextStyle}" Text="Restore factory display &amp; flat EQ"/>
                                        <TextBlock Style="{StaticResource BodyTextStyle}" FontSize="10" Text="{Binding PanicHotkeyLabel}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Reset Now" Style="{StaticResource DangerButtonStyle}" Command="{Binding PanicResetCommand}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right column -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#FFFF4136"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEqEngineEnabled}" Value="True">
                                                        <Setter Property="Fill" Value="#FF00E676"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="BUILT-IN EQUALIZER" Style="{StaticResource HeaderTextStyle}"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource BodyTextStyle}"
                                                   Text="Enables Gamer Tool's own system-wide EQ engine. One-time admin approval." TextWrapping="Wrap"/>
                                        <TextBlock Style="{StaticResource BodyTextStyle}" FontSize="10" Margin="0,4,0,0"
                                                   Text="If sliders do nothing audible, the engine isn't enabled yet." TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="Active" Foreground="{StaticResource AccentBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"
                                                   Visibility="{Binding IsEqEngineEnabled, Converter={StaticResource BoolToVisConverter}}"/>
                                        <Button Content="Enable" Style="{StaticResource NeonButtonStyle}" Padding="12,5"
                                                Command="{Binding EnableEqEngineCommand}"
                                                Visibility="{Binding IsEqEngineEnabled, Converter={StaticResource InverseBoolToVisConverter}}"/>
                                        <Button Content="Disable" Style="{StaticResource DangerButtonStyle}" Padding="12,5"
                                                Command="{Binding DisableEqEngineCommand}"
                                                Visibility="{Binding IsEqEngineEnabled, Converter={StaticResource BoolToVisConverter}}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource BodyTextStyle}" Foreground="{StaticResource MutedTextBrush}"
                                           Text="{Binding EqStatusText, Mode=OneWay}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Visibility="{Binding EqStatusText, Converter={StaticResource StringToVisConverter}}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

            </Grid>
        </Grid>

        <!-- ===================== STATUS BAR ===================== -->
        <Border Grid.Row="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedTextBrush}" FontSize="10"
                       VerticalAlignment="Center" Margin="14,0,0,0"/>
        </Border>

        <!-- ===================== HOTKEY RECORDING OVERLAY ===================== -->
        <Border Grid.Row="0" Grid.RowSpan="3" Background="#CC000000"
                Visibility="{Binding IsRecordingHotkey, Converter={StaticResource BoolToVisConverter}}">
            <Border Style="{StaticResource CardBorderStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
                <StackPanel>
                    <TextBlock Text="RECORDING HOTKEY" Style="{StaticResource HeaderTextStyle}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding RecordingTargetLabel}" Style="{StaticResource BodyTextStyle}" HorizontalAlignment="Center" Margin="0,0,0,14"/>

                    <ItemsControl ItemsSource="{Binding PendingKeycaps, Mode=OneWay}" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="3,0">
                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource AccentBrush}"
                                               FontWeight="Bold" FontSize="14" FontFamily="Consolas"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding PendingHotkeyLabel, Mode=OneWay}"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                               FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding PendingConflictText, Mode=OneWay}"
                               FontSize="11" TextAlignment="Center" Margin="0,0,0,14" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPendingConflict}" Value="True">
                                        <Setter Property="Foreground" Value="#FFFFB74D"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Set" Style="{StaticResource NeonButtonStyle}" Padding="22,6"
                                Command="{Binding ConfirmPendingHotkeyCommand}" Margin="0,0,8,0"/>
                        <Button Content="Clear" Style="{StaticResource SecondaryButtonStyle}" Padding="14,6"
                                Command="{Binding ClearPendingHotkeyCommand}" Margin="0,0,8,0"/>
                        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Click="CancelHotkeyRecording_Click"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource BodyTextStyle}" TextAlignment="Center" FontSize="10" Margin="0,10,0,0"
                               Text="Tip: Ctrl+Alt+F1-F12 never conflicts with games. Esc cancels."/>
                </StackPanel>
            </Border>
        </Border>

        <!-- ===================== OSD TOAST ===================== -->
        <Border Grid.Row="0" Grid.RowSpan="3" Background="Transparent" IsHitTestVisible="False"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVisConverter}}"
                VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,56,0,0">
            <Border Background="{StaticResource CardBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="16,8">
                <TextBlock Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="14"
                           Text="{Binding ToastText, Mode=OneWay}" HorizontalAlignment="Center"/>
            </Border>
        </Border>

        <!-- ===================== TEST MODE BANNER ===================== -->
        <Border Grid.Row="0" Grid.RowSpan="3" Background="#CC000000" IsHitTestVisible="False"
                Visibility="{Binding IsTestModeActive, Converter={StaticResource BoolToVisConverter}}">
            <Border Background="{StaticResource CardBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                    CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16,10">
                <TextBlock Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="12"
                           Text="{Binding TestModeText, Mode=OneWay}"/>
            </Border>
        </Border>

    </Grid>
</Window>
