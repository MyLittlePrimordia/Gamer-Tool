<Window x:Class="GamerTool.UI.RetroOsd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gamer Tool"
        Width="560"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Border x:Name="Frame" Margin="10" Background="#F20A0A0A" BorderBrush="#332DD4BF" BorderThickness="1" CornerRadius="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.6" Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <Border Height="3" CornerRadius="2" Margin="18,14,18,0" Background="#2DD4BF" HorizontalAlignment="Left" Width="34" />
            <TextBlock x:Name="HeadText"
                       Margin="18,10,18,0"
                       FontFamily="Cascadia Mono, Consolas, monospace"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#EDEFF3"
                       Text="GAMER TOOL" />
            <TextBlock x:Name="SubText"
                       Margin="18,4,18,16"
                       FontFamily="Segoe UI, Inter, sans-serif"
                       FontSize="12"
                       Foreground="#98A1B0"
                       Text="SCREEN + SOUND" />
        </StackPanel>
    </Border>
</Window>
