<Window x:Class="GamerTool.UI.RetroOsd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gamer Tool"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- OLED black, so the toast sits on the picture instead of on top of it, and
         sized to its text so a short message does not get a wide empty plate. The
         accent dot carries the state colour and the rest stays quiet. -->
    <Border x:Name="Frame" Margin="12" Background="#F0000000" BorderBrush="#28FFFFFF"
            BorderThickness="1" CornerRadius="11" Padding="14,9">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.75" Color="#000000" />
        </Border.Effect>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="Dot" Width="7" Height="7" Fill="#2DD4BF" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock x:Name="HeadText"
                       FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#F2F5F7"
                       MaxWidth="360"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       Text="Gamer Tool" />
        </StackPanel>
    </Border>
</Window>
