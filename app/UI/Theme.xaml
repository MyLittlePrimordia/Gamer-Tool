<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:GamerTool.UI">

    <!-- ============================================================
         OLED BLACK
         The window body is true #000000 so an OLED panel switches those
         pixels off. Surfaces step up in tiny increments (#070707, #0E0E0E)
         so depth is readable without ever looking like a grey panel.
         ============================================================ -->
    <SolidColorBrush x:Key="AppBg" Color="#000000" />
    <SolidColorBrush x:Key="PageBg" Color="#000000" />
    <SolidColorBrush x:Key="CardBg" Color="#070707" />
    <SolidColorBrush x:Key="WellBg" Color="#030303" />
    <SolidColorBrush x:Key="Elevated" Color="#0E0E0E" />
    <SolidColorBrush x:Key="Hover" Color="#171717" />
    <SolidColorBrush x:Key="Line" Color="#1A1A1A" />
    <SolidColorBrush x:Key="LineStrong" Color="#2C2C2C" />
    <!-- The unfilled part of a fader track. This has to be clearly lighter than
         the page, or the knob reads as a loose dot with nothing holding it
         rather than as a handle sitting on a bar. -->
    <SolidColorBrush x:Key="Groove" Color="#333333" />

    <SolidColorBrush x:Key="TextHi" Color="#EDEDED" />
    <SolidColorBrush x:Key="TextMid" Color="#8E8E8E" />
    <SolidColorBrush x:Key="TextLow" Color="#5E5E5E" />

    <!-- One accent per tab. Kept desaturated just enough to sit on black
         without vibrating, and each has a dim partner for tinted fills. -->
    <SolidColorBrush x:Key="AccentDisplay" Color="#22D3EE" />
    <SolidColorBrush x:Key="AccentDisplayGlow" Color="#0B1F26" />
    <!-- Matched against the engine's own accent rather than picked by eye. It is
         a hotter, redder rose than a pastel pink, and the difference is obvious
         when the two sit side by side. -->
    <SolidColorBrush x:Key="AccentAudio" Color="#FF2D6F" />
    <SolidColorBrush x:Key="AccentAudioGlow" Color="#2E0A19" />
    <SolidColorBrush x:Key="AccentHotkeys" Color="#5B8DEF" />
    <SolidColorBrush x:Key="AccentHotkeysGlow" Color="#0E1730" />
    <SolidColorBrush x:Key="AccentSettings" Color="#34D399" />
    <SolidColorBrush x:Key="AccentSettingsGlow" Color="#0A1F18" />

    <SolidColorBrush x:Key="Green" Color="#34D399" />
    <SolidColorBrush x:Key="Amber" Color="#FBBF24" />
    <SolidColorBrush x:Key="Red" Color="#F87171" />

    <FontFamily x:Key="Sans">Segoe UI Variable Text, Segoe UI, Inter, system-ui, sans-serif</FontFamily>
    <FontFamily x:Key="SansDisplay">Segoe UI Variable Display, Segoe UI, Inter, system-ui, sans-serif</FontFamily>
    <FontFamily x:Key="Mono">Cascadia Mono, Consolas, Courier New, monospace</FontFamily>
    <FontFamily x:Key="Emoji">Segoe UI Emoji, Segoe UI Symbol, sans-serif</FontFamily>

    <!-- ==================== TYPE ==================== -->

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextHi}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Page heading. Small on purpose: the nav pill already names the tab. -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SansDisplay}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextHi}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- All-caps micro label used for card headings. -->
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextLow}" />
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SansDisplay}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextHi}" />
    </Style>

    <Style x:Key="CardSub" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{StaticResource TextMid}" />
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextMid}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Readout for a slider. Mono + right aligned so digits stop jittering. -->
    <Style x:Key="Value" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextHi}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- ==================== SURFACES ==================== -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style x:Key="InnerCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WellBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <Style x:Key="Well" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WellBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <!-- Page sections are not boxed. Groups are separated by hairlines, a tile is
         a borderless panel used only where a repeated item needs a shape of its
         own, and the hero is the single raised surface each tab is built around. -->
    <!-- Every tab is the same single panel: one rounded surface with a header
         strip, a body and a footer strip, divided by hairlines instead of a grid
         of boxes. Sections inside share that one surface so nothing feels
         boxed in, and the only raised inset on a tab is its hero. -->
      <Style x:Key="PagePanel" TargetType="Border">
          <!-- Deliberately borderless. The app frame is the only border, and it
               is the window edge. A second rounded edge here made the title
               strip and the status line read as being outside the frame. -->
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="CornerRadius" Value="0" />
          <Setter Property="SnapsToDevicePixels" Value="True" />
      </Style>

    <!-- Hero inset: the one thing a tab is built around, given a slightly deeper
         well so the eye lands on it first. -->
    <Style x:Key="Hero" TargetType="Border">
        <Setter Property="Background" Value="#000000" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style x:Key="Hairline" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource Line}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="VHairline" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Background" Value="{StaticResource Line}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Tile" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBg}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!-- ==================== TITLE BAR ==================== -->

    <!-- Caption buttons. The mark is the only thing that changes: the strokes in
         the window bind to the button's own Foreground, so a whole state is one
         property, and the plate stays transparent so nothing is drawn behind it
         and the black chrome is left unbroken.

         The dash takes the app's display cyan and the cross takes red, so the two
         can be told apart at a glance without reading them. Each brightens while
         it is held, and the pressed trigger is listed second on purpose: a held
         button is also a hovered one, triggers fire in order, and the later one
         is the one that sticks.

         Close repeats the template instead of sharing one with the dash. Same
         reason the nav pills do it: a ControlTemplate trigger cannot read a custom
         property back off its own templated parent, so two accents means two
         copies of the template. It is BasedOn the dash so the metrics stay in one
         place. -->
    <!-- A row in the settings list that is not a switch: an emoji, a label, and
         whatever control belongs on the right. Same height, same plate and the
         same hover as an option row, so the list reads as one thing rather than
         as switches with some other controls mixed in.

         No hand cursor here, unlike an option row where the whole row is the
         target. On the rows where only the control on the right does anything,
         a hand over the empty half of the row would promise a click that does
         not happen. The controls carry their own.

         Only the plate is shared. The three rows that use it carry different
         contents and differ in whether the whole row or just the control is the
         click target, so each still writes its own five column grid inside. -->
    <Style x:Key="ActionRow" TargetType="Border">
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#0AFFFFFF" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="44" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="#D0D0D0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#22D3EE" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" Value="#7DEFFA" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#F87171" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" Value="#FFB4B4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== NAV PILL ====================
         Emoji above a 9pt label. The emoji are baked colour bitmaps, because
         WPF cannot draw COLR/CPAL glyphs at all. Only the plate and the label
         carry the tab accent, so the mark stays the same in both states. -->

    <!-- Four self contained tab templates rather than one shared template with
         per instance accents: a ControlTemplate trigger cannot read a custom
         property back off its own templated parent, so each accent gets its own
         copy of the ten line template. -->
    <Style x:Key="NavDisplay" TargetType="ui:NavPill">
        <Setter Property="Tag" Value="0" />
        <Setter Property="Glyph" Value="desktop" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="86" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:NavPill">
                    <Border x:Name="Bg" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:EmojiImage HorizontalAlignment="Center" Width="23" Height="23" Stretch="Uniform" Glyph="{TemplateBinding Glyph}" />
                            <TextBlock x:Name="Label" Text="Display" Margin="0,2,0,0" HorizontalAlignment="Center"
                                       FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextLow}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#0DFFFFFF" />
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextMid}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentDisplayGlow}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentDisplay}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource AccentDisplay}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavAudio" TargetType="ui:NavPill">
        <Setter Property="Tag" Value="1" />
        <Setter Property="Glyph" Value="speaker" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="86" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:NavPill">
                    <Border x:Name="Bg" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:EmojiImage HorizontalAlignment="Center" Width="23" Height="23" Stretch="Uniform" Glyph="{TemplateBinding Glyph}" />
                            <TextBlock x:Name="Label" Text="Audio" Margin="0,2,0,0" HorizontalAlignment="Center"
                                       FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextLow}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#0DFFFFFF" />
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextMid}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentAudioGlow}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentAudio}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource AccentAudio}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavHotkeys" TargetType="ui:NavPill">
        <Setter Property="Tag" Value="2" />
        <Setter Property="Glyph" Value="key" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="86" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:NavPill">
                    <Border x:Name="Bg" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:EmojiImage HorizontalAlignment="Center" Width="23" Height="23" Stretch="Uniform" Glyph="{TemplateBinding Glyph}" />
                            <TextBlock x:Name="Label" Text="Hotkeys" Margin="0,2,0,0" HorizontalAlignment="Center"
                                       FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextLow}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#0DFFFFFF" />
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextMid}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentHotkeysGlow}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentHotkeys}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource AccentHotkeys}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavSettings" TargetType="ui:NavPill">
        <Setter Property="Tag" Value="3" />
        <Setter Property="Glyph" Value="gear" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="86" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:NavPill">
                    <Border x:Name="Bg" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:EmojiImage HorizontalAlignment="Center" Width="23" Height="23" Stretch="Uniform" Glyph="{TemplateBinding Glyph}" />
                            <TextBlock x:Name="Label" Text="Settings" Margin="0,2,0,0" HorizontalAlignment="Center"
                                       FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextLow}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#0DFFFFFF" />
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextMid}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentSettingsGlow}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentSettings}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource AccentSettings}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== BUTTONS ==================== -->

    <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextHi}" />
        <Setter Property="Background" Value="{StaticResource Elevated}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LineStrong}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.65" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.32" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="#1D6F68" />
        <Setter Property="Foreground" Value="#EAFBF7" />
        <Setter Property="BorderBrush" Value="#2A9D92" />
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextMid}" />
    </Style>

    <Style x:Key="WarnButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="#3A2A08" />
        <Setter Property="Foreground" Value="{StaticResource Amber}" />
        <Setter Property="BorderBrush" Value="#6B4E10" />
    </Style>

    <!-- Vector icon button. The glyph is a stroked outline scaled inside a
         Viewbox, so one 24 unit path reads correctly at any button size. -->
    <Style x:Key="IconButton" TargetType="ui:IconButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TextMid}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:IconButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                        <!-- The glyph is centred explicitly on all three axes
                             rather than left to the Viewbox, which was measured
                             putting every icon about two pixels down and to the
                             right of the middle of its own button. -->
                        <Grid Background="Transparent">
                            <Viewbox Width="{TemplateBinding IconSize}" Height="{TemplateBinding IconSize}"
                                     Stretch="Uniform"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Measured correction. Every glyph was landing about
                                     2.3 units down and to the right of the middle of
                                     its own button, and that offset survived changing
                                     the alignments, the wrapping and the device pixel
                                     snapping, so it is corrected here explicitly
                                     rather than left to look almost right. -->
                                <Viewbox.RenderTransform>
                                    <TranslateTransform X="-2.3" Y="-2.3" />
                                </Viewbox.RenderTransform>
                                <Path x:Name="Glyph" Data="{TemplateBinding Icon}"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.7" StrokeLineJoin="Round" Fill="Transparent"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Viewbox>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LineStrong}" />
                            <Setter Property="Foreground" Value="{StaticResource TextHi}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



    <!-- ==================== SLIDERS ==================== -->

    <Style x:Key="ModernSlider" TargetType="Slider">
        <Setter Property="Height" Value="20" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent" VerticalAlignment="Center">
                        <Border Height="4" CornerRadius="2" Background="{StaticResource Groove}" VerticalAlignment="Center" />
                        <Track x:Name="PART_Track" Height="16" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                    Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent" Width="16" Height="16">
                                                <!-- The ring colour comes from the slider's Foreground. A
                                                     trigger cannot read that back off the templated
                                                     parent, so it is faded in with Opacity instead. -->
                                                <Ellipse x:Name="Ring" Width="16" Height="16" StrokeThickness="1.5" Opacity="0"
                                                         Stroke="{TemplateBinding Foreground}" />
                                                <Ellipse x:Name="Knob" Width="11" Height="11" Fill="#F0F0F0"
                                                         VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                                    <Setter TargetName="Knob" Property="Width" Value="13" />
                                                    <Setter TargetName="Knob" Property="Height" Value="13" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                                    <Setter TargetName="Knob" Property="Width" Value="13" />
                                                    <Setter TargetName="Knob" Property="Height" Value="13" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bipolar horizontal slider, for a control whose range runs both ways round
         a neutral point: brightness, contrast, master gain, balance.

         ModernSlider fills Minimum to Value, which is the right reading for a
         control whose minimum is its empty state, and badly wrong for one whose
         minimum is the far end of a negative range. At 0 those four looked half
         boosted, which is the one thing a fader must never do: the fill is the
         part of the control that is supposed to answer "what is actually
         changed from stock" without being read.

         So the fill is drawn as its own two-halves grid growing out of the middle
         and Track.DecreaseRepeatButton is made transparent. It has to be done that
         way round: that button spans Minimum to Value and there is no way to tell
         it to start somewhere in the middle instead. The Track itself is left
         exactly as it is, underneath and still on top for the thumb, so dragging,
         ticks and hit testing are untouched.

         The halves are inset 8px a side because the thumb is 16 wide and sits
         centred on the value. The usable travel is the width less the thumb, and
         without the inset each half would be 8px too long and stop short of the
         thumb at full deflection. The converter is handed this host's own width
         and halves it, which lands the ends exactly on the thumb. -->
    <Style x:Key="ModernSliderBipolar" TargetType="Slider">
        <Setter Property="Height" Value="20" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent" VerticalAlignment="Center">
                        <Border Height="4" CornerRadius="2" Background="{StaticResource Groove}" VerticalAlignment="Center" />

                        <Grid x:Name="BipolarHost" Margin="8,0,8,0" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Height="4" CornerRadius="2" HorizontalAlignment="Right"
                                    Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}">
                                <Border.Width>
                                    <MultiBinding>
                                        <MultiBinding.Converter>
                                            <ui:BandFillConverter Above="False" />
                                        </MultiBinding.Converter>
                                        <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="ActualWidth" ElementName="BipolarHost" />
                                    </MultiBinding>
                                </Border.Width>
                            </Border>

                            <Border Grid.Column="2" Height="4" CornerRadius="2" HorizontalAlignment="Left"
                                    Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}">
                                <Border.Width>
                                    <MultiBinding>
                                        <MultiBinding.Converter>
                                            <ui:BandFillConverter Above="True" />
                                        </MultiBinding.Converter>
                                        <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="ActualWidth" ElementName="BipolarHost" />
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                        </Grid>

                        <Track x:Name="PART_Track" Height="16" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent" Width="16" Height="16">
                                                <!-- The ring colour comes from the slider's Foreground. A
                                                     trigger cannot read that back off the templated
                                                     parent, so it is faded in with Opacity instead. -->
                                                <Ellipse x:Name="Ring" Width="16" Height="16" StrokeThickness="1.5" Opacity="0"
                                                         Stroke="{TemplateBinding Foreground}" />
                                                <Ellipse x:Name="Knob" Width="11" Height="11" Fill="#F0F0F0"
                                                         VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                                    <Setter TargetName="Knob" Property="Width" Value="13" />
                                                    <Setter TargetName="Knob" Property="Height" Value="13" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                                    <Setter TargetName="Knob" Property="Width" Value="13" />
                                                    <Setter TargetName="Knob" Property="Height" Value="13" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- EQ and colour-trim fader. Bipolar: the coloured fill grows out of the
         zero line in the middle of the travel towards whichever side the band is
         pushed, so a fader sitting at rest is an empty groove.

         The whole template scales to the control's own Width so the same style
         serves a 34px fader in a 10 band strip and a 13px one in a 31 band strip,
         which is what keeps every band count inside the column instead of
         spilling out of it. -->
    <Style x:Key="BandSliderVertical" TargetType="Slider">
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="TickFrequency" Value="0.5" />
        <Setter Property="Orientation" Value="Vertical" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent" Width="{TemplateBinding Width}">

                        <!-- Groove first so the fills sit on top of it, then the
                             invisible track that does the actual dragging. The band
                             strip gets a dashed groove because that is how the
                             engine draws its bands; the colour trims share this
                             template and keep a solid one. -->
                        <Grid x:Name="GrooveHost" Width="5" HorizontalAlignment="Center">
                            <!-- Width is stated rather than left to stretch: with
                                 HorizontalAlignment set to Center and nothing
                                 inside it, a Border would size itself to zero. -->
                            <Border x:Name="Groove" Width="5" CornerRadius="2.5" Background="{StaticResource Groove}"
                                    HorizontalAlignment="Center" />
                            <!-- The dashes come from a tiled brush rather than a dashed
                                 stroke. A line has no width to speak of here, so a
                                 stroke dash pattern has nothing to run along, and a
                                 tiling brush keeps the dash length in real pixels
                                 whatever height the strip ends up. -->
                            <!-- Populated with real rectangles by BandFader once the
                                 track has been measured. Narrower than the solid
                                 groove the colour trims use, because the engine's
                                 band line is a fine dash rather than a bar. -->
                            <Canvas x:Name="DashHost" Width="3" HorizontalAlignment="Center" />
                        </Grid>

                        <Grid Width="5" HorizontalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid x:Name="UpperHalf" Grid.Row="0">
                                <!-- The fill's opacity follows the value, solid at +12 and
                                     faint at -12, so a boost and a cut do not look equally
                                     heavy. Only the fill changes; the groove, handle and
                                     zero tick stay equally legible. -->
                                <Border x:Name="UpperFill" CornerRadius="2.5" VerticalAlignment="Bottom">
                                    <Border.Background>
                                        <MultiBinding>
                                            <MultiBinding.Converter>
                                                <ui:BandTintConverter />
                                            </MultiBinding.Converter>
                                            <Binding Path="Foreground" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" />
                                        </MultiBinding>
                                    </Border.Background>
                                    <Border.Height>
                                        <MultiBinding>
                                            <MultiBinding.Converter>
                                                <ui:BandFillConverter Above="True" />
                                            </MultiBinding.Converter>
                                            <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="ActualHeight" RelativeSource="{RelativeSource TemplatedParent}" />
                                        </MultiBinding>
                                    </Border.Height>
                                </Border>
                            </Grid>

                            <Grid x:Name="LowerHalf" Grid.Row="2">
                                <Border x:Name="LowerFill" CornerRadius="2.5" VerticalAlignment="Top">
                                    <Border.Background>
                                        <MultiBinding>
                                            <MultiBinding.Converter>
                                                <ui:BandTintConverter />
                                            </MultiBinding.Converter>
                                            <Binding Path="Foreground" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" />
                                        </MultiBinding>
                                    </Border.Background>
                                    <Border.Height>
                                        <MultiBinding>
                                            <MultiBinding.Converter>
                                                <ui:BandFillConverter Above="False" />
                                            </MultiBinding.Converter>
                                            <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="ActualHeight" RelativeSource="{RelativeSource TemplatedParent}" />
                                        </MultiBinding>
                                    </Border.Height>
                                </Border>
                            </Grid>
                        </Grid>



                        <Track x:Name="PART_Track" Width="{TemplateBinding Width}" HorizontalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <!-- A ring rather than the old flat dash, to match
                                                 FxSound's equaliser. Eleven pixels is the
                                                 largest that still fits the twelve pixel
                                                 fader a 31 band strip gets, so the knob
                                                 looks the same at every band count. -->
                                            <Grid Background="Transparent" Width="{TemplateBinding Width}" Height="22">
                                                <Ellipse x:Name="Ring" Width="11" Height="11"
                                                         VerticalAlignment="Center" HorizontalAlignment="Center"
                                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" />
                                                <Ellipse x:Name="Hole" Width="5" Height="5"
                                                         VerticalAlignment="Center" HorizontalAlignment="Center"
                                                         Fill="#0B0B0B" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Ring" Property="Width" Value="13" />
                                                    <Setter TargetName="Ring" Property="Height" Value="13" />
                                                    <Setter TargetName="Hole" Property="Fill" Value="#000000" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Ring" Property="Width" Value="13" />
                                                    <Setter TargetName="Ring" Property="Height" Value="13" />
                                                    <Setter TargetName="Hole" Property="Fill" Value="#000000" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Whether a band draws as a dashed line or a solid
                             groove is decided by BandFader, which owns all four
                             of the elements involved so they change together. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Groove" Property="Opacity" Value="0.4" />
                            <Setter TargetName="DashHost" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Three 40px-tall colour trims sit side by side, so they read as a
         compact group instead of a third column of long sliders. -->
    <Style x:Key="TrimSlider" TargetType="Slider" BasedOn="{StaticResource ModernSlider}">
        <Setter Property="Height" Value="46" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <!-- ==================== SWITCHES ==================== -->

    <Style x:Key="ModernToggle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource AccentSettings}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" Width="34" Height="20" CornerRadius="10"
                            Background="#141414" BorderBrush="{StaticResource LineStrong}" BorderThickness="1">
                        <Ellipse x:Name="Knob" Width="12" Height="12" Fill="#767676" HorizontalAlignment="Left" Margin="3,0,0,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="Knob" Property="Fill" Value="#04231A" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.82" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Emoji + label + switch. One click anywhere on the row flips it. The whole
         row is the hit area, and the emoji keeps its own colour when the row is
         on or off so the setting still reads at a glance. -->

    <Style x:Key="OptionRow" TargetType="ui:OptionToggle">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:OptionToggle">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Padding="8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:EmojiImage Grid.Column="0" VerticalAlignment="Center" Stretch="Uniform"
                                           Width="{TemplateBinding GlyphSize}" Height="{TemplateBinding GlyphSize}"
                                           Glyph="{TemplateBinding Glyph}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{TemplateBinding Label}"
                                       FontFamily="{StaticResource Sans}" FontSize="12"
                                       Foreground="{TemplateBinding Foreground}" TextTrimming="CharacterEllipsis" />
                            <Border x:Name="Track" Grid.Column="4" Width="34" Height="20" CornerRadius="10"
                                    Background="#141414" BorderBrush="{StaticResource LineStrong}" BorderThickness="1">
                                <Ellipse x:Name="Knob" Width="12" Height="12" Fill="#767676" HorizontalAlignment="Left" Margin="3,0,0,0" />
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#0AFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentSettings}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="Knob" Property="Fill" Value="#04231A" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextLow}" />
                            <Setter TargetName="Track" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="Foreground" Value="{StaticResource TextHi}" />
    </Style>

    <!-- ==================== INPUTS ==================== -->

    <Style x:Key="ModernTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextHi}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextHi}" />
        <Setter Property="SelectionBrush" Value="#1D6F68" />
        <Setter Property="Background" Value="{StaticResource WellBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#2A9D92" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hotkey capture box. Reads as a keycap so it is obvious it records keys. -->
    <Style x:Key="KeyCap" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="24" />
    </Style>

    <!-- ==================== MARQUEE ====================
         A clipped window that slides its content sideways when the content is
         wider than the box and the pointer is on it. AllowMarquee is read off
         the templated parent, so the shared ComboBox templates below can carry
         the behaviour and leave every dropdown that has not asked for it
         completely unchanged.

         There is deliberately no Canvas in here. A Canvas reports a zero
         DesiredSize.Height to its parent here, which collapsed every dropdown
         row to zero height and left the names invisible. Measured straight, the
         content still reports its true width, because the templates in use (a
         horizontal StackPanel, or a Grid with an Auto column) measure their own
         children against infinity. That true width is the whole point: it is
         what says the name does not fit. -->

    <Style x:Key="MarqueeBox" TargetType="ui:MarqueeBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:MarqueeBox">
                    <Grid x:Name="Clip" Background="Transparent" ClipToBounds="True">
                        <ContentPresenter x:Name="Host" HorizontalAlignment="Left"
                                          VerticalAlignment="Center" RenderTransformOrigin="0,0.5" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Row template for the LOAD WHEN dropdown: launcher icon beside the app name. -->
    <DataTemplate x:Key="AppIconItem">
        <Grid HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="7" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Width="15" Height="15" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Icon}" />
            <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="11.5"
                       Foreground="{StaticResource TextHi}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
    </DataTemplate>

    <Style x:Key="ModernCombo" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource TextHi}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Bd" Background="{StaticResource WellBg}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="7" Padding="9,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:MarqueeBox x:Name="Content" Grid.Column="0" Margin="0,0,6,0"
                                              Style="{StaticResource MarqueeBox}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              AllowMarquee="{Binding (ui:MarqueeBox.AllowMarquee), RelativeSource={RelativeSource TemplatedParent}}" />
                                <Path x:Name="Arrow" Grid.Column="1" Width="8" Height="5" VerticalAlignment="Center"
                                      Data="M 0 0 L 4 4.5 L 8 0 Z" Fill="#7A7A7A" />
                            </Grid>
                        </Border>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                               VerticalOffset="4" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               PopupAnimation="Fade" Focusable="False">
                            <Border Background="#0A0A0A" BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                                    CornerRadius="8" Padding="4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LineStrong}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Preset picker: taller than a plain combo because it is the page's
         primary control and its text is the answer to "what am I editing". -->
    <Style x:Key="PresetCombo" TargetType="ComboBox" BasedOn="{StaticResource ModernCombo}">
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <!-- Marks a preset the user saved, so the shipped presets and their own are
         told apart at a glance in a list that is otherwise all the same. The chip
         is only shown for custom entries. -->
    <!-- Declared here rather than reused from the window, because a StaticResource
         has to resolve inside its own dictionary at parse time. -->
    <ui:InverseBoolToVisibilityConverter x:Key="ThemeInverseBool" />

    <DataTemplate x:Key="PresetChoiceItem">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            <Border Margin="7,0,0,0" CornerRadius="4" Padding="5,1" VerticalAlignment="Center"
                    Background="#1C1C1C"
                    Visibility="{Binding BuiltIn, Converter={StaticResource ThemeInverseBool}}">
                <TextBlock Text="YOURS" FontSize="8.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextLow}" />
            </Border>
        </StackPanel>
    </DataTemplate>
    <Style x:Key="ModernComboItem" TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource TextHi}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="9,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Elevated}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#123A36" />
                            <Setter Property="Foreground" Value="#7FE8DC" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== CHROME ==================== -->

    <!-- No border and no raised fill: the tab strip sits directly on the
         window's OLED black, so the only chrome is the selected pill. Padding
         is sized to the 46px pill plus its 3px margin so the row never clips. -->
    <Style x:Key="NavTrack" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AppBg}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ToolBar" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style x:Key="StatusBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PageBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
          <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <Style x:Key="HiddenTabs" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Border Background="Transparent">
                        <ContentPresenter ContentSource="SelectedContent" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Day / night segmented switch, colour emoji in both states. -->
    <Style x:Key="PillTab" TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="24" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource Emoji}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The day and night pair. Two pixels of padding rather than three so the
         track comes out exactly 30 tall, matching the 30 tall play button in the
         audio card's header. The two cards then have identical inner geometry,
         so the preview and the spectrum boxes sit in the same place. -->
    <Style x:Key="PillTrack" TargetType="Border">
        <Setter Property="Background" Value="#0A0A0A" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="2" />
    </Style>

    <!-- ==================== SCROLLBAR ====================
         Only ever reached as a safety net: the pages are sized so nothing
         overflows, but a user can pile on unlimited custom presets and slots. -->
    <Style x:Key="ModernScroll" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#2E2E2E" CornerRadius="3" Width="4" HorizontalAlignment="Center" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Make the thin dark scrollbar the default everywhere, including the
         dropdown popups, so no stock light-grey bar can ever show up. -->
    <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScroll}" />

    <!-- Deliberately visible slim bar, used only on the Hotkeys tab, which is the
         one page allowed to scroll because the slot list has no natural ceiling. -->
    <Style x:Key="SlimScroll" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Bar" Background="#2A2A2A" CornerRadius="2" Width="3"
                                                    HorizontalAlignment="Center" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bar" Property="Background" Value="#4A4A4A" />
                                                    <Setter TargetName="Bar" Property="Width" Value="5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!-- ==================== TOOLTIP ==================== -->

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#101010" />
        <Setter Property="Foreground" Value="#D8D8D8" />
        <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="MaxWidth" Value="260" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
