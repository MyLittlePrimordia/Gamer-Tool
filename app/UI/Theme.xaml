<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- OLED black: true #000000 backdrop, near-black surfaces, and dim greys
         instead of blue-tinted greys so pixels switch off on an OLED panel. -->
    <SolidColorBrush x:Key="RailBg" Color="#000000" />
    <SolidColorBrush x:Key="AppBg" Color="#000000" />
    <SolidColorBrush x:Key="CardBg" Color="#050505" />
    <SolidColorBrush x:Key="CardHover" Color="#0C0C0C" />
    <SolidColorBrush x:Key="Elevated" Color="#131313" />
    <SolidColorBrush x:Key="Line" Color="#1C1C1C" />
    <SolidColorBrush x:Key="LineStrong" Color="#2B2B2B" />

    <SolidColorBrush x:Key="TextHi" Color="#F2F2F2" />
    <SolidColorBrush x:Key="TextMid" Color="#9A9A9A" />
    <SolidColorBrush x:Key="TextLow" Color="#6B6B6B" />

    <SolidColorBrush x:Key="Teal" Color="#2DD4BF" />
    <SolidColorBrush x:Key="TealDim" Color="#0E2A28" />
    <SolidColorBrush x:Key="Blurple" Color="#6366F1" />
    <SolidColorBrush x:Key="BlurpleDim" Color="#191940" />
    <SolidColorBrush x:Key="Pink" Color="#F472B6" />
    <SolidColorBrush x:Key="PinkDim" Color="#2C1A26" />
    <SolidColorBrush x:Key="Green" Color="#34D399" />
    <SolidColorBrush x:Key="GreenDim" Color="#0F2620" />
    <SolidColorBrush x:Key="Amber" Color="#FBBF24" />
    <SolidColorBrush x:Key="AmberDim" Color="#2C2313" />
    <SolidColorBrush x:Key="Red" Color="#F87171" />
    <SolidColorBrush x:Key="RedDim" Color="#2C1818" />

    <SolidColorBrush x:Key="AccentDisplay" Color="#22D3EE" />
    <SolidColorBrush x:Key="AccentDisplayDim" Color="#0A2830" />
    <SolidColorBrush x:Key="AccentAudio" Color="#F472B6" />
    <SolidColorBrush x:Key="AccentAudioDim" Color="#2C1A26" />
    <SolidColorBrush x:Key="AccentHotkeys" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentHotkeysDim" Color="#0E1E38" />
    <SolidColorBrush x:Key="AccentSettings" Color="#34D399" />
    <SolidColorBrush x:Key="AccentSettingsDim" Color="#0C251E" />

    <SolidColorBrush x:Key="PageBg" Color="#000000" />
    <SolidColorBrush x:Key="PillBg" Color="#0A0A0A" />
    <SolidColorBrush x:Key="WellBg" Color="#030303" />

    <FontFamily x:Key="Sans">Segoe UI Variable Text, Segoe UI, Inter, system-ui, sans-serif</FontFamily>
    <FontFamily x:Key="SansDisplay">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI, Inter, sans-serif</FontFamily>
    <FontFamily x:Key="Mono">Cascadia Mono, Consolas, Courier New, monospace</FontFamily>

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextHi}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SansDisplay}" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextHi}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextLow}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextHi}" />
    </Style>

    <Style x:Key="CardSub" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextMid}" />
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextMid}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Value" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextHi}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="InnerCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{StaticResource WellBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style x:Key="Well" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WellBg}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextHi}" />
        <Setter Property="Background" Value="{StaticResource Elevated}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="MinWidth" Value="104" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource Blurple}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="Foreground" Value="{StaticResource TextMid}" />
    </Style>

    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="{StaticResource Elevated}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    </Style>

    <Style x:Key="RoundIconButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="52" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontFamily" Value="Segoe UI Emoji" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <Style x:Key="Chip" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextMid}" />
        <Setter Property="Background" Value="#CC0D0D0D" />
        <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                            <Setter Property="Foreground" Value="{StaticResource TextHi}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernSlider" TargetType="Slider">
        <Setter Property="Height" Value="24" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent" VerticalAlignment="Center">
                        <Border Height="6" CornerRadius="3" Background="#1A1A1A" VerticalAlignment="Center" />
                        <Track x:Name="PART_Track" Height="22" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="6" CornerRadius="3" VerticalAlignment="Center" Background="#2DD4BF" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent" Width="22" Height="22">
                                                <Ellipse x:Name="Ring" Width="22" Height="22" Stroke="Transparent" StrokeThickness="2" />
                                                <Ellipse Width="15" Height="15" Fill="#EDEDED" Stroke="#000000" StrokeThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Ring" Property="Stroke" Value="#2DD4BF" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Ring" Property="Stroke" Value="#2DD4BF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="6" CornerRadius="3" VerticalAlignment="Center" Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PinkSlider" TargetType="Slider" BasedOn="{StaticResource ModernSlider}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent" VerticalAlignment="Center">
                        <Border Height="6" CornerRadius="3" Background="#1A1A1A" VerticalAlignment="Center" />
                        <Track x:Name="PART_Track" Height="22" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="6" CornerRadius="3" VerticalAlignment="Center" Background="#F472B6" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent" Width="22" Height="22">
                                                <Ellipse x:Name="Ring" Width="22" Height="22" Stroke="Transparent" StrokeThickness="2" />
                                                <Ellipse Width="15" Height="15" Fill="#EDEDED" Stroke="#000000" StrokeThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Ring" Property="Stroke" Value="#F472B6" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Ring" Property="Stroke" Value="#F472B6" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="6" CornerRadius="3" VerticalAlignment="Center" Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BandSlider" TargetType="Slider" BasedOn="{StaticResource PinkSlider}">
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="TickFrequency" Value="0.5" />
    </Style>

    <!-- Vertical EQ slider. Built from a real vertical track rather than a rotated
         horizontal one so thumb dragging, page steps and click-to-position all work. -->
    <Style x:Key="BandSliderVertical" TargetType="Slider">
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="TickFrequency" Value="0.5" />
        <Setter Property="Orientation" Value="Vertical" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent" Width="34">
                        <Border x:Name="Groove" Width="6" CornerRadius="3" Background="#141414" HorizontalAlignment="Center" />
                        <Track x:Name="PART_Track" Width="26" HorizontalAlignment="Center" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Width="6" CornerRadius="3" HorizontalAlignment="Center" Background="#F472B6" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent" Width="26" Height="26">
                                                <Ellipse x:Name="Ring" Width="26" Height="26" Stroke="Transparent" StrokeThickness="2" />
                                                <Ellipse Width="15" Height="15" Fill="#EDEDED" Stroke="#000000" StrokeThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Ring" Property="Stroke" Value="#F472B6" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Ring" Property="Stroke" Value="#F472B6" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Width="6" CornerRadius="3" HorizontalAlignment="Center" Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Groove" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernToggle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" Width="38" Height="22" CornerRadius="11" Background="#1A1A1A" BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <Ellipse x:Name="Knob" Width="16" Height="16" Fill="#8A8A8A" HorizontalAlignment="Left" Margin="3,0,0,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Blurple}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="Knob" Property="Fill" Value="#FFFFFF" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToggleRow" TargetType="CheckBox" BasedOn="{StaticResource ModernToggle}">
        <Setter Property="Foreground" Value="{StaticResource TextHi}" />
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border Background="Transparent" Padding="0,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center"
                                              TextElement.FontFamily="{TemplateBinding FontFamily}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <Border x:Name="Track" Grid.Column="1" Width="38" Height="22" CornerRadius="11" Background="#1A1A1A" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                <Ellipse x:Name="Knob" Width="16" Height="16" Fill="#8A8A8A" HorizontalAlignment="Left" Margin="3,0,0,0" />
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Blurple}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="Knob" Property="Fill" Value="#FFFFFF" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextLow}" />
                            <Setter TargetName="Track" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextHi}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextHi}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Blurple}" />
        <Setter Property="Background" Value="{StaticResource WellBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Blurple}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Row template for the LOAD WHEN dropdown: launcher icon beside the app name.
         The icon column is fixed so names stay aligned even for rows without one. -->
    <DataTemplate x:Key="AppIconItem">
        <Grid HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0"
                   Width="16"
                   Height="16"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Source="{Binding Icon}" />
            <TextBlock Grid.Column="2"
                       Text="{Binding Name}"
                       FontSize="13"
                       Foreground="{StaticResource TextHi}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
    </DataTemplate>

    <Style x:Key="ModernCombo" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextHi}" />
        <Setter Property="Background" Value="{StaticResource AppBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Bd" Background="{StaticResource AppBg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="12,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="Content" Grid.Column="0" Margin="0,3,6,3" VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                                <Path x:Name="Arrow" Grid.Column="1" Width="9" Height="6" Margin="0,0,2,0" VerticalAlignment="Center"
                                      Data="M 0 0 L 4.5 5 L 9 0 Z" Fill="#8A8A8A" />
                            </Grid>
                        </Border>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                               VerticalOffset="6" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               PopupAnimation="Fade" Focusable="False">
                            <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="14" Padding="6"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LineStrong}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernComboItem" TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextHi}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <ContentPresenter
                            TextElement.FontFamily="{TemplateBinding FontFamily}"
                            TextElement.FontSize="{TemplateBinding FontSize}"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Elevated}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BlurpleDim}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Row" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BlurpleDim}" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="10,4" />
    </Style>

    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource TealDim}" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <Style x:Key="TabPillTrack" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PillBg}" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="TabPillItem" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextMid}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="18" Padding="22,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.82" />
                            <Setter Property="Foreground" Value="{StaticResource TextHi}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TabPillDisplay" TargetType="RadioButton" BasedOn="{StaticResource TabPillItem}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentDisplay}" />
                <Setter Property="Foreground" Value="#08161A" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TabPillAudio" TargetType="RadioButton" BasedOn="{StaticResource TabPillItem}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentAudio}" />
                <Setter Property="Foreground" Value="#2A0E1C" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TabPillHotkeys" TargetType="RadioButton" BasedOn="{StaticResource TabPillItem}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentHotkeys}" />
                <Setter Property="Foreground" Value="#06152B" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TabPillSettings" TargetType="RadioButton" BasedOn="{StaticResource TabPillItem}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentSettings}" />
                <Setter Property="Foreground" Value="#062018" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PillTrack" TargetType="Border">
        <Setter Property="Background" Value="#0A0A0A" />
        <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="3" />
    </Style>

    <!-- Day/night segmented pill. Keeps the colour emoji glyphs but uses a rounded
         rectangle track instead of the old 32x26 oval (CornerRadius 999). -->
    <Style x:Key="PillTab" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource TextMid}" />
        <Setter Property="FontFamily" Value="Segoe UI Emoji" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="9">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PillTabActive" TargetType="Button" BasedOn="{StaticResource PillTab}">
        <Setter Property="Background" Value="{StaticResource TealDim}" />
        <Setter Property="Foreground" Value="{StaticResource Teal}" />
    </Style>

    <Style x:Key="PreviewFrameStyle" TargetType="Border">
        <Setter Property="Background" Value="#000000" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="200" />
    </Style>

    <Style x:Key="PreviewScrim" TargetType="Border">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0" />
                    <GradientStop Color="#B3000000" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="StatusBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PageBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="24,8" />
    </Style>

    <Style x:Key="ModernScroll" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#333333" CornerRadius="3" Width="6" Margin="2,0" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HiddenTabs" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Border Background="Transparent">
                        <ContentPresenter ContentSource="SelectedContent" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderRow" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="PresetCardButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="14">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
