<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:ui="clr-namespace:GamerTool.UI">

    <!-- ============================================================
         OLED BLACK
         The window body is true #000000 so an OLED panel switches those
         pixels off. Surfaces step up in tiny increments (#070707, #0E0E0E)
         so depth is readable without ever looking like a grey panel.
         ============================================================ -->
    <!-- ============================================================
         RADIUS SCALE
         There were ten corner radii in use across the app and no rule
         behind any of them: 14 on the frame, 13 on the frame's clip
         and the nav track, 12 on the modal, 10 on surfaces, 9 on the
         nav pills, 8 on controls, 7 on wells and pickers, 6 on chips and
         menus, and 4 on two badges, one of which was hardcoded in C#.
         Four values cover every one of those roles, and a fifth is
         derived from the frame for the clip that has to line up with it.
         ============================================================ -->
    <CornerRadius x:Key="RadiusFrame">14</CornerRadius>
    <CornerRadius x:Key="RadiusSurface">10</CornerRadius>
    <CornerRadius x:Key="RadiusControl">8</CornerRadius>
    <CornerRadius x:Key="RadiusChip">4</CornerRadius>
    <!-- The window's content is clipped to the frame's own shape, one pixel in,
         so the rounding has to be the frame's rounding less that pixel. Deriving
         it here rather than restating the arithmetic in a comment is what stops
         the two drifting apart the next time the frame changes. -->
    <CornerRadius x:Key="RadiusClip">13</CornerRadius>

    <!-- ============================================================
         HOVER
         Three different hovers for the same idea: a solid fill on the
         buttons, five percent white on the nav pills, four percent on
         the list rows and eight percent on the small pills. One fill
         and one overlay, and the alpha is the same everywhere. -->
    <SolidColorBrush x:Key="HoverFill" Color="#171717" />
    <SolidColorBrush x:Key="HoverOverlay" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="HoverOverlayStrong" Color="#14FFFFFF" />

    <SolidColorBrush x:Key="DisabledOpacityBrush" Color="#FFFFFF" />
    <sys:Double x:Key="DisabledOpacity">0.35</sys:Double>
    <sys:Double x:Key="PressedOpacity">0.65</sys:Double>

    <!-- The focus ring. Every focusable control in the app showed nothing at all
         when reached by keyboard, and most could not be reached by keyboard in
         the first place because their styles set Focusable to false. The ring is
         a light neutral rather than any tab accent so it reads the same on all
         four tabs, and it is brighter than every surface it lands on. -->
    <SolidColorBrush x:Key="FocusRing" Color="#EAFBF7" />
    <SolidColorBrush x:Key="FocusRingFill" Color="#1AFFFFFF" />

    <SolidColorBrush x:Key="AppBg" Color="#000000" />
    <SolidColorBrush x:Key="PageBg" Color="#000000" />
    <SolidColorBrush x:Key="CardBg" Color="#070707" />
    <SolidColorBrush x:Key="WellBg" Color="#030303" />
    <SolidColorBrush x:Key="Elevated" Color="#0E0E0E" />
    <SolidColorBrush x:Key="Hover" Color="#171717" />
    <SolidColorBrush x:Key="Line" Color="#1A1A1A" />
    <SolidColorBrush x:Key="LineStrong" Color="#2C2C2C" />
    <!-- The unfilled part of a fader track. This has to be clearly lighter than
         the page, or the knob reads as a loose dot with nothing holding it
         rather than as a handle sitting on a bar. -->
    <SolidColorBrush x:Key="Groove" Color="#333333" />

    <SolidColorBrush x:Key="TextHi" Color="#EDEDED" />
    <SolidColorBrush x:Key="TextMid" Color="#8E8E8E" />
    <SolidColorBrush x:Key="TextLow" Color="#5E5E5E" />

    <!-- One accent per tab. Kept desaturated just enough to sit on black
         without vibrating, and each has a dim partner for tinted fills. -->
    <SolidColorBrush x:Key="AccentDisplay" Color="#22D3EE" />
    <SolidColorBrush x:Key="AccentDisplayGlow" Color="#0B1F26" />
    <!-- Sampled out of a running FxSound window rather than picked by eye, which
         is how a pink ends up nearly right and not quite: the previous value,
         #FF2D6F, is brighter and leans magenta, so the Audio tab and the app it
         is imitating read as two different pinks.
         The glow is the same hue at the far end of the same scale, so the pair
         cannot drift apart. -->
    <SolidColorBrush x:Key="AccentAudio" Color="#E33250" />
    <SolidColorBrush x:Key="AccentAudioGlow" Color="#2E040A" />
    <SolidColorBrush x:Key="AccentHotkeys" Color="#5B8DEF" />
    <SolidColorBrush x:Key="AccentHotkeysGlow" Color="#0E1730" />
    <SolidColorBrush x:Key="AccentSettings" Color="#34D399" />
    <SolidColorBrush x:Key="AccentSettingsGlow" Color="#0A1F18" />

    <SolidColorBrush x:Key="Green" Color="#34D399" />
    <SolidColorBrush x:Key="Amber" Color="#FBBF24" />
    <SolidColorBrush x:Key="Red" Color="#F87171" />

    <FontFamily x:Key="Sans">Segoe UI Variable Text, Segoe UI, Inter, system-ui, sans-serif</FontFamily>
    <FontFamily x:Key="SansDisplay">Segoe UI Variable Display, Segoe UI, Inter, system-ui, sans-serif</FontFamily>
    <FontFamily x:Key="Mono">Cascadia Mono, Consolas, Courier New, monospace</FontFamily>
    <FontFamily x:Key="Emoji">Segoe UI Emoji, Segoe UI Symbol, sans-serif</FontFamily>

    <!-- ==================== TYPE ==================== -->

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextHi}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- All-caps micro label used for card headings. -->
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextLow}" />
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SansDisplay}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextHi}" />
    </Style>

    <Style x:Key="CardSub" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{StaticResource TextMid}" />
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextMid}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Readout for a slider. Mono + right aligned so digits stop jittering. -->
    <Style x:Key="Value" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextHi}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- ==================== SURFACES ==================== -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSurface}" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style x:Key="Well" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WellBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <!-- The name plate on a slot card, and the only part of the card that renames.
         It started as a transparent TextBlock, so the click target was the width
         of the word and the only thing that said it was clickable was the mouse
         pointer changing. Everything either side of it did nothing, which reads
         as the card being clickable and is not.

         Deliberately built to the same measurements as ModernCombo - same
         background, border colour, corner radius, padding and 28 pixel height -
         because it is now the same kind of thing: a box on a row of boxes, and
         one that is a different size is one that reads as a mistake rather than
         as a name. Those five values are the style's whole purpose and there is
         a test that checks they have not drifted apart from the combo's.

         The dropdown arrow is the one thing it does not have, and leaving it off
         is on purpose. The arrow says "there is a list under here"; the plate
         opens a rename box. The other odd thing on the row, the keycap, is odd
         because it is a key and not a picker, and that one is a real difference
         rather than a styling one.

         A Button rather than a Border, for the template and because a Border
         cannot take one. Which also means the plate answers Enter and Space,
         so renaming a slot does not require a mouse any more. -->
    <Style x:Key="NamePlate" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource TextHi}" />
        <Setter Property="Background" Value="{StaticResource WellBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusControl}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LineStrong}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FocusRing}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Page sections are not boxed. Groups are separated by hairlines, a tile is
         a borderless panel used only where a repeated item needs a shape of its
         own, and the hero is the single raised surface each tab is built around. -->
    <!-- Every tab is the same single panel: one rounded surface with a header
         strip, a body and a footer strip, divided by hairlines instead of a grid
         of boxes. Sections inside share that one surface so nothing feels
         boxed in, and the only raised inset on a tab is its hero. -->
      <Style x:Key="PagePanel" TargetType="Border">
          <!-- Deliberately borderless. The app frame is the only border, and it
               is the window edge. A second rounded edge here made the title
               strip and the status line read as being outside the frame. -->
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="CornerRadius" Value="0" />
          <Setter Property="SnapsToDevicePixels" Value="True" />
      </Style>

    <!-- Hero inset: the one thing a tab is built around, given a slightly deeper
         well so the eye lands on it first. -->
    <Style x:Key="Hero" TargetType="Border">
        <Setter Property="Background" Value="#000000" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSurface}" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style x:Key="Hairline" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource Line}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="VHairline" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Background" Value="{StaticResource Line}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Tile" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBg}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSurface}" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!-- ==================== TITLE BAR ==================== -->

    <!-- Caption buttons. The mark is the only thing that changes: the strokes in
         the window bind to the button's own Foreground, so a whole state is one
         property, and the plate stays transparent so nothing is drawn behind it
         and the black chrome is left unbroken.

         The dash takes the app's display cyan and the cross takes red, so the two
         can be told apart at a glance without reading them. Each brightens while
         it is held, and the pressed trigger is listed second on purpose: a held
         button is also a hovered one, triggers fire in order, and the later one
         is the one that sticks.

         Close repeats the template instead of sharing one with the dash. Same
         reason the nav pills do it: a ControlTemplate trigger cannot read a custom
         property back off its own templated parent, so two accents means two
         copies of the template. It is BasedOn the dash so the metrics stay in one
         place. -->
    <!-- A row in the settings list that is not a switch: an emoji, a label, and
         whatever control belongs on the right. Same height, same plate and the
         same hover as an option row, so the list reads as one thing rather than
         as switches with some other controls mixed in.

         No hand cursor here, unlike an option row where the whole row is the
         target. On the rows where only the control on the right does anything,
         a hand over the empty half of the row would promise a click that does
         not happen. The controls carry their own.

         Only the plate is shared. The three rows that use it carry different
         contents and differ in whether the whole row or just the control is the
         click target, so each still writes its own five column grid inside. -->
  <Style x:Key="ActionRow" TargetType="Border">
    <Setter Property="Height" Value="40" />
    <!-- Same gap as OptionRow and for the same reason: these rows are in the
         same list as the switches, so a different rhythm would be visible as a
         jog where one kind of row gives way to the other. That is the job the
         dividers used to do, and they were three lines that earned none. -->
    <Setter Property="Margin" Value="0,4,0,0" />

        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource HoverOverlay}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="44" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="#D0D0D0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#22D3EE" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" Value="#7DEFFA" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource FocusRingFill}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FocusRing}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#F87171" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" Value="#FFB4B4" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource FocusRingFill}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FocusRing}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== NAV PILL ====================
         Emoji above a 9pt label. The emoji are baked colour bitmaps, because
         WPF cannot draw COLR/CPAL glyphs at all. Only the plate and the label
         carry the tab accent, so the mark stays the same in both states. -->

    <!-- Four self contained tab templates rather than one shared template with
         per instance accents: a ControlTemplate trigger cannot read a custom
         property back off its own templated parent, so each accent gets its own
         copy of the ten line template. -->
    <!--
      The small info button that sits beside a switch. It borrows the nav tabs'
      treatment exactly: a faint white wash on hover and a focus ring for the
      keyboard, so it reads as part of the same control language rather than as a
      stray control. It deliberately has no idle background and no border, because
      a button that is visible before you touch it competes with the verdict it is
      explaining.

      This style was removed along with the display row's "why is this not
      working" button and then referenced again when a similar button went into the
      settings list. The result was an app that compiled clean, passed every test,
      and would not start: a missing StaticResource is a runtime failure and no
      compiler will report it. Kept as one shared style precisely so there is one
      place for that to go wrong and it is greppable.
    -->
    <Style x:Key="InfoHintButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" BorderBrush="Transparent"
                            BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Padding="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#0DFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource FocusRing}" />
                            <Setter TargetName="Bg" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavDisplay" TargetType="ui:NavPill">
        <Setter Property="Tag" Value="0" />
        <Setter Property="Glyph" Value="desktop" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="86" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:NavPill">
                    <Border x:Name="Bg" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource RadiusControl}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:EmojiImage HorizontalAlignment="Center" Width="23" Height="23" Stretch="Uniform" Glyph="{TemplateBinding Glyph}" />
                            <TextBlock x:Name="Label" Text="Display" Margin="0,2,0,0" HorizontalAlignment="Center"
                                       FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextLow}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#0DFFFFFF" />
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextMid}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentDisplayGlow}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentDisplay}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource AccentDisplay}" />
                        </Trigger>
<Trigger Property="IsKeyboardFocusWithin" Value="True">
<Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource FocusRing}" />
<Setter TargetName="Bg" Property="BorderThickness" Value="2" />
</Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavAudio" TargetType="ui:NavPill">
        <Setter Property="Tag" Value="1" />
        <Setter Property="Glyph" Value="speaker" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="86" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:NavPill">
                    <Border x:Name="Bg" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource RadiusControl}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:EmojiImage HorizontalAlignment="Center" Width="23" Height="23" Stretch="Uniform" Glyph="{TemplateBinding Glyph}" />
                            <TextBlock x:Name="Label" Text="Audio" Margin="0,2,0,0" HorizontalAlignment="Center"
                                       FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextLow}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#0DFFFFFF" />
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextMid}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentAudioGlow}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentAudio}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource AccentAudio}" />
                        </Trigger>
<Trigger Property="IsKeyboardFocusWithin" Value="True">
<Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource FocusRing}" />
<Setter TargetName="Bg" Property="BorderThickness" Value="2" />
</Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavHotkeys" TargetType="ui:NavPill">
        <Setter Property="Tag" Value="2" />
        <!-- A keyboard, not a key. The panic key binding on this tab is marked
             with the key emoji, and two things on one screen meaning the same
             thing is how one of them stops meaning anything. -->
        <Setter Property="Glyph" Value="keyboard" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="86" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:NavPill">
                    <Border x:Name="Bg" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource RadiusControl}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:EmojiImage HorizontalAlignment="Center" Width="23" Height="23" Stretch="Uniform" Glyph="{TemplateBinding Glyph}" />
                            <TextBlock x:Name="Label" Text="Hotkeys" Margin="0,2,0,0" HorizontalAlignment="Center"
                                       FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextLow}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#0DFFFFFF" />
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextMid}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentHotkeysGlow}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentHotkeys}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource AccentHotkeys}" />
                        </Trigger>
<Trigger Property="IsKeyboardFocusWithin" Value="True">
<Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource FocusRing}" />
<Setter TargetName="Bg" Property="BorderThickness" Value="2" />
</Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavSettings" TargetType="ui:NavPill">
        <Setter Property="Tag" Value="3" />
        <Setter Property="Glyph" Value="gear" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="86" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:NavPill">
                    <Border x:Name="Bg" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource RadiusControl}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:EmojiImage HorizontalAlignment="Center" Width="23" Height="23" Stretch="Uniform" Glyph="{TemplateBinding Glyph}" />
                            <TextBlock x:Name="Label" Text="Settings" Margin="0,2,0,0" HorizontalAlignment="Center"
                                       FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextLow}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#0DFFFFFF" />
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextMid}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentSettingsGlow}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentSettings}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource AccentSettings}" />
                        </Trigger>
<Trigger Property="IsKeyboardFocusWithin" Value="True">
<Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource FocusRing}" />
<Setter TargetName="Bg" Property="BorderThickness" Value="2" />
</Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== BUTTONS ==================== -->

    <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextHi}" />
        <Setter Property="Background" Value="{StaticResource Elevated}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusControl}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                      <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverFill}" />
                              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LineStrong}" />
                          </Trigger>
                          <Trigger Property="IsPressed" Value="True">
                              <Setter TargetName="Bd" Property="Opacity" Value="{StaticResource PressedOpacity}" />
                          </Trigger>
                          <Trigger Property="IsEnabled" Value="False">
                              <Setter TargetName="Bd" Property="Opacity" Value="{StaticResource DisabledOpacity}" />
                          </Trigger>
                          <Trigger Property="IsKeyboardFocusWithin" Value="True">
                              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FocusRing}" />
                              <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                          </Trigger>
                      </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="#1D6F68" />
        <Setter Property="Foreground" Value="#EAFBF7" />
        <Setter Property="BorderBrush" Value="#2A9D92" />
    </Style>

    <!-- The same button in the audio accent.
         A style cannot be parameterised, so a second style is the only way to
         give one tab its own colour here without putting a pink button on the
         display tab. The fills are the audio accent knocked back for a large
         block of colour sitting on black, which is the same treatment the
         accent itself gets further up, rather than the full accent at button
         size, which would be far too hot. -->
    <Style x:Key="PrimaryButtonAudio" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="#6B1729" />
        <Setter Property="Foreground" Value="#FCEFF2" />
        <Setter Property="BorderBrush" Value="#A8223B" />
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextMid}" />
    </Style>

    <!-- Vector icon button. The glyph is a stroked outline scaled inside a
         Viewbox, so one 24 unit path reads correctly at any button size. -->
    <Style x:Key="IconButton" TargetType="ui:IconButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TextMid}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:IconButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusControl}">
          <!-- The glyph is centred on all three axes, and IconNudge is
               applied to the Viewbox rather than to the path inside it.
               Both details were arrived at by measuring the rendered
               button rather than by looking at it.

               The nudge belongs on the Viewbox because that is the
               element whose size is IconSize, so a correction there is
               in the same units the measurement was taken in. On the
               path it would be a canvas unit scaled by whatever factor
               the Viewbox happened to apply, which is not a number
               anyone can check by reading it.

               What it corrects is the difference between the middle of
               the bounding box and the middle of the ink, which are
               not the same thing: a magnifier is a ring with a thin
               handle, so most of its mass sits up and to the left. Those
               offsets are in Icons.cs, measured, and the largest is
               about a pixel. -->
          <Grid Background="Transparent">
            <Viewbox Width="{TemplateBinding IconSize}" Height="{TemplateBinding IconSize}"
                     Stretch="Uniform"
                     RenderTransform="{TemplateBinding IconNudge}"
                     HorizontalAlignment="Center" VerticalAlignment="Center">
              <Path x:Name="Glyph" Data="{TemplateBinding Icon}"
                    Stroke="{TemplateBinding Foreground}"
                    StrokeThickness="1.7" StrokeLineJoin="Round" Fill="Transparent"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Viewbox>
          </Grid>

                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverFill}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LineStrong}" />
                            <Setter Property="Foreground" Value="{StaticResource TextHi}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="{StaticResource DisabledOpacity}" />
                        </Trigger>
<Trigger Property="IsKeyboardFocusWithin" Value="True">
<Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FocusRing}" />
<Setter TargetName="Bd" Property="BorderThickness" Value="2" />
</Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



    <!-- ==================== SLIDERS ==================== -->

    <Style x:Key="ModernSlider" TargetType="Slider">
        <Setter Property="Height" Value="20" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent" VerticalAlignment="Center">
                        <Border Height="4" CornerRadius="2" Background="{StaticResource Groove}" VerticalAlignment="Center" />
                        <Track x:Name="PART_Track" Height="16" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                    Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent" Width="16" Height="16">
                                                <!-- The ring colour comes from the slider's Foreground. A
                                                     trigger cannot read that back off the templated
                                                     parent, so it is faded in with Opacity instead. -->
                                                <Ellipse x:Name="Ring" Width="16" Height="16" StrokeThickness="1.5" Opacity="0"
                                                         Stroke="{TemplateBinding Foreground}" />
                                                <Ellipse x:Name="Knob" Width="11" Height="11" Fill="#F0F0F0"
                                                         VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                                    <Setter TargetName="Knob" Property="Width" Value="13" />
                                                    <Setter TargetName="Knob" Property="Height" Value="13" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                                    <Setter TargetName="Knob" Property="Width" Value="13" />
                                                    <Setter TargetName="Knob" Property="Height" Value="13" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                                    <Setter TargetName="Knob" Property="Width" Value="13" />
                                                    <Setter TargetName="Knob" Property="Height" Value="13" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bipolar horizontal slider, for a control whose range runs both ways round
         a neutral point: brightness, contrast, master gain, balance.

         ModernSlider fills Minimum to Value, which is the right reading for a
         control whose minimum is its empty state, and badly wrong for one whose
         minimum is the far end of a negative range. At 0 those four looked half
         boosted, which is the one thing a fader must never do: the fill is the
         part of the control that is supposed to answer "what is actually
         changed from stock" without being read.

         So the fill is drawn as its own two-halves grid growing out of the middle
         and Track.DecreaseRepeatButton is made transparent. It has to be done that
         way round: that button spans Minimum to Value and there is no way to tell
         it to start somewhere in the middle instead. The Track itself is left
         exactly as it is, underneath and still on top for the thumb, so dragging,
         ticks and hit testing are untouched.

         The halves are inset 8px a side because the thumb is 16 wide and sits
         centred on the value. The usable travel is the width less the thumb, and
         without the inset each half would be 8px too long and stop short of the
         thumb at full deflection. The converter is handed this host's own width
         and halves it, which lands the ends exactly on the thumb. -->
    <Style x:Key="ModernSliderBipolar" TargetType="Slider">
        <Setter Property="Height" Value="20" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent" VerticalAlignment="Center">
                        <Border Height="4" CornerRadius="2" Background="{StaticResource Groove}" VerticalAlignment="Center" />

                        <Grid x:Name="BipolarHost" Margin="8,0,8,0" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Height="4" CornerRadius="2" HorizontalAlignment="Right"
                                    Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}">
                                <Border.Width>
                                    <MultiBinding>
                                        <MultiBinding.Converter>
                                            <ui:BandFillConverter Above="False" />
                                        </MultiBinding.Converter>
                                        <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="ActualWidth" ElementName="BipolarHost" />
                                    </MultiBinding>
                                </Border.Width>
                            </Border>

                            <Border Grid.Column="2" Height="4" CornerRadius="2" HorizontalAlignment="Left"
                                    Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}">
                                <Border.Width>
                                    <MultiBinding>
                                        <MultiBinding.Converter>
                                            <ui:BandFillConverter Above="True" />
                                        </MultiBinding.Converter>
                                        <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="ActualWidth" ElementName="BipolarHost" />
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                        </Grid>

                        <Track x:Name="PART_Track" Height="16" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent" Width="16" Height="16">
                                                <!-- The ring colour comes from the slider's Foreground. A
                                                     trigger cannot read that back off the templated
                                                     parent, so it is faded in with Opacity instead. -->
                                                <Ellipse x:Name="Ring" Width="16" Height="16" StrokeThickness="1.5" Opacity="0"
                                                         Stroke="{TemplateBinding Foreground}" />
                                                <Ellipse x:Name="Knob" Width="11" Height="11" Fill="#F0F0F0"
                                                         VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                                    <Setter TargetName="Knob" Property="Width" Value="13" />
                                                    <Setter TargetName="Knob" Property="Height" Value="13" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                                    <Setter TargetName="Knob" Property="Width" Value="13" />
                                                    <Setter TargetName="Knob" Property="Height" Value="13" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                                    <Setter TargetName="Knob" Property="Width" Value="13" />
                                                    <Setter TargetName="Knob" Property="Height" Value="13" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- EQ and colour-trim fader. Bipolar: the coloured fill grows out of the
         zero line in the middle of the travel towards whichever side the band is
         pushed, so a fader sitting at rest is an empty groove.

         The whole template scales to the control's own Width so the same style
         serves a 34px fader in a 10 band strip and a 13px one in a 31 band strip,
         which is what keeps every band count inside the column instead of
         spilling out of it. -->
    <Style x:Key="BandSliderVertical" TargetType="Slider">
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <!-- A quarter of a decibel. This is the app's choice and not a limit in the
             engine: the live push formats a gain with one decimal and the preset
             file with two, so a finer step is carried all the way. A tenth was
             available too and is finer than the roughly one decibel that most
             people can actually hear on a band, so a quarter is the useful
             resolution rather than the finest one. -->
        <Setter Property="TickFrequency" Value="0.25" />
        <Setter Property="Orientation" Value="Vertical" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent" Width="{TemplateBinding Width}">

                        <!-- Groove first so the fills sit on top of it, then the
                             invisible track that does the actual dragging. The band
                             strip gets a dashed groove because that is how the
                             engine draws its bands; the colour trims share this
                             template and keep a solid one. -->
                        <Grid x:Name="GrooveHost" Width="5" HorizontalAlignment="Center">
                            <!-- Width is stated rather than left to stretch: with
                                 HorizontalAlignment set to Center and nothing
                                 inside it, a Border would size itself to zero. -->
                            <Border x:Name="Groove" Width="5" CornerRadius="2.5" Background="{StaticResource Groove}"
                                    HorizontalAlignment="Center" />
                            <!-- The dashes come from a tiled brush rather than a dashed
                                 stroke. A line has no width to speak of here, so a
                                 stroke dash pattern has nothing to run along, and a
                                 tiling brush keeps the dash length in real pixels
                                 whatever height the strip ends up. -->
                            <!-- Populated with real rectangles by BandFader once the
                                 track has been measured. Narrower than the solid
                                 groove the colour trims use, because the engine's
                                 band line is a fine dash rather than a bar. -->
                            <Canvas x:Name="DashHost" Width="2" HorizontalAlignment="Center" />
                        </Grid>

                        <Grid Width="5" HorizontalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid x:Name="UpperHalf" Grid.Row="0">
                                <!-- The fill's opacity follows the value, solid at +12 and
                                     faint at -12, so a boost and a cut do not look equally
                                     heavy. Only the fill changes; the groove, handle and
                                     zero tick stay equally legible. -->
                                <Border x:Name="UpperFill" CornerRadius="2.5" VerticalAlignment="Bottom">
                                    <Border.Background>
                                        <MultiBinding>
                                            <MultiBinding.Converter>
                                                <ui:BandTintConverter />
                                            </MultiBinding.Converter>
                                            <Binding Path="Foreground" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" />
                                        </MultiBinding>
                                    </Border.Background>
                                    <Border.Height>
                                        <MultiBinding>
                                            <MultiBinding.Converter>
                                                <ui:BandFillConverter Above="True" />
                                            </MultiBinding.Converter>
                                            <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="ActualHeight" RelativeSource="{RelativeSource TemplatedParent}" />
                                        </MultiBinding>
                                    </Border.Height>
                                </Border>
                            </Grid>

                            <Grid x:Name="LowerHalf" Grid.Row="2">
                                <Border x:Name="LowerFill" CornerRadius="2.5" VerticalAlignment="Top">
                                    <Border.Background>
                                        <MultiBinding>
                                            <MultiBinding.Converter>
                                                <ui:BandTintConverter />
                                            </MultiBinding.Converter>
                                            <Binding Path="Foreground" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" />
                                        </MultiBinding>
                                    </Border.Background>
                                    <Border.Height>
                                        <MultiBinding>
                                            <MultiBinding.Converter>
                                                <ui:BandFillConverter Above="False" />
                                            </MultiBinding.Converter>
                                            <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="ActualHeight" RelativeSource="{RelativeSource TemplatedParent}" />
                                        </MultiBinding>
                                    </Border.Height>
                                </Border>
                            </Grid>
                        </Grid>



                        <Track x:Name="PART_Track" Width="{TemplateBinding Width}" HorizontalAlignment="Center">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border Background="Transparent" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <!-- Named so the window can ask the thumb where it actually is.
                     A vertical Track keeps the thumb's centre half a thumb inside
                     each end, so the knob cannot reach the very top or the very
                     bottom of the band area, and the equaliser curve has to be
                     drawn to the knob rather than the other way round. The knob is
                     deliberately not hidden or shrunk to get that travel: it is
                     the slider's drag handle, and a hidden one is not hit tested,
                     which silently stops the band responding to the mouse. -->
                <Thumb x:Name="BandThumb" Width="{TemplateBinding Width}">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <!-- A solid white knob, the same handle the effect sliders use,
                         so the band faders and a Clarity or Dynamic Boost slider
                         read as one set of controls.
                         It used to be a ring with a black dot in the middle. The
                         black was a fix for a different problem: with the centre
                         left open, the dashed band line showed straight through
                         the knob as it was dragged past. Filling it solid fixes
                         that better than the black dot did, because an opaque disc
                         hides the line completely instead of making the hole look
                         deliberate. Fourteen pixels rather than the effect sliders'
                         eleven, because this sits on a tall vertical fader where a
                         smaller handle is harder to line up with a band. -->
                    <Grid Background="Transparent" Width="{TemplateBinding Width}" Height="22">
                      <Ellipse x:Name="Ring" Width="14" Height="14"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               Fill="#F0F0F0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Ring" Property="Width" Value="16" />
                        <Setter TargetName="Ring" Property="Height" Value="16" />
                      </Trigger>
                      <Trigger Property="IsDragging" Value="True">
                        <Setter TargetName="Ring" Property="Width" Value="16" />
                        <Setter TargetName="Ring" Property="Height" Value="16" />
                      </Trigger>
                    </ControlTemplate.Triggers>

                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Whether a band draws as a dashed line or a solid
                             groove is decided by BandFader, which owns all four
                             of the elements involved so they change together. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Groove" Property="Opacity" Value="0.4" />
                            <Setter TargetName="DashHost" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== SWITCHES ====================

         One switch, one set of numbers, one set of states. It used to exist twice:
         once as a standalone toggle and once inlined in the settings list's row,
         because a template trigger cannot read a custom property back off its own
         templated parent. The sizes had already drifted apart, and so had the
         behaviour, which is why the anti-clip switch on the Audio tab was rose
         while every switch in Settings was green with no way to ask otherwise.

         The Accent is set by the style, not read off the templated parent, so both
         places can point at this one template. -->

    <Style x:Key="SwitchTrack" TargetType="ui:SwitchToggle">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:SwitchToggle">
                    <Border x:Name="Track" Width="34" Height="20" CornerRadius="10"
                            Background="#141414" BorderBrush="{StaticResource LineStrong}" BorderThickness="1">
                        <Ellipse x:Name="Knob" Width="12" Height="12" Fill="#767676" HorizontalAlignment="Left" Margin="3,0,0,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{Binding Accent, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="Transparent" />

                            <!-- The handle is the same near-white the dial knobs
                                 and the effect slider handles use, so a switched
                                 on toggle reads as the same control family. It
                                 was #04231A, a near black left over from when
                                 the accent was only ever the display's teal: on
                                 a saturated track that looked like a hole rather
                                 than a handle, and the hue belonged to a colour
                                 no other tab was using. -->
                            <Setter TargetName="Knob" Property="Fill" Value="#F0F0F0" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.82" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="{StaticResource DisabledOpacity}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource FocusRing}" />
                            <Setter TargetName="Track" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Emoji + label + switch. One click anywhere on the row flips it. The whole
         row is the hit area, and the emoji keeps its own colour when the row is
         on or off so the setting still reads at a glance. -->
  <Style x:Key="OptionRow" TargetType="ui:OptionToggle">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Height" Value="40" />
    <!-- The gap between rows lives here rather than on each row in the list, so
         that every row is spaced identically by construction. It used to be set
         on the first two rows only, which left the third sitting flush against
         the second and the list with a step in it halfway down. -->
    <Setter Property="Margin" Value="0,4,0,0" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:OptionToggle">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="{StaticResource RadiusControl}" Padding="8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:EmojiImage Grid.Column="0" VerticalAlignment="Center" Stretch="Uniform"
                                           Width="{TemplateBinding GlyphSize}" Height="{TemplateBinding GlyphSize}"
                                           Glyph="{TemplateBinding Glyph}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{TemplateBinding Label}"
                                       FontFamily="{StaticResource Sans}" FontSize="12"
                                       Foreground="{TemplateBinding Foreground}" TextTrimming="CharacterEllipsis" />

                            <!-- The badge, in its own Auto column so that a row
                                 without one closes the gap completely and looks
                                 untouched. It sits between the label and the
                                 switch so a row that can explain itself does so
                                 on the same line as the thing being explained. -->
                            <Button x:Name="PART_Badge" Grid.Column="3"
                                    Style="{StaticResource InfoHintButton}"
                                    VerticalAlignment="Center" Visibility="Visible"
                                    ToolTip="{TemplateBinding BadgeToolTip}"
                                    AutomationProperties.Name="{TemplateBinding BadgeToolTip}">
                                <ui:EmojiImage Glyph="info" Width="15" Height="15" />
                            </Button>

                            <!-- The shared switch, not a second copy of it. The row's
                                 accent comes from Accent rather than being hardcoded,
                                 so this list can be a different colour from the
                                 standalone toggles if it ever needs to be. -->
                            <ui:SwitchToggle Grid.Column="5" Style="{StaticResource SwitchTrack}"
                                              Accent="{StaticResource AccentSettings}"
                                              IsChecked="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Driven off the glyph rather than a separate visibility
                             property, so there is no way for the two to disagree
                             about whether the row has a badge. A Trigger on the
                             property itself rather than a DataTrigger, because
                             TemplateBinding is not a Binding and cannot be used
                             for one. -->
                        <Trigger Property="BadgeGlyph" Value="">
                            <Setter TargetName="PART_Badge" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverOverlay}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextLow}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource FocusRingFill}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="Foreground" Value="{StaticResource TextHi}" />
    </Style>


    <!-- ==================== INPUTS ==================== -->

    <Style x:Key="ModernTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextHi}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextHi}" />
        <Setter Property="SelectionBrush" Value="#1D6F68" />
        <Setter Property="Background" Value="{StaticResource WellBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusControl}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                        </Trigger>
<Trigger Property="IsKeyboardFocusWithin" Value="True">
<Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FocusRing}" />
<Setter TargetName="Bd" Property="BorderThickness" Value="2" />
</Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hotkey capture box. Reads as a keycap so it is obvious it records keys.
         Read only on purpose: it shows a binding, it does not accept text. When
         it was editable, typing into it left the box claiming something the slot
         did not actually have, because only the key handler ever wrote through. -->
    <Style x:Key="KeyCap" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="IsUndoEnabled" Value="False" />
        <Setter Property="CaretBrush" Value="Transparent" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Height" Value="24" />
    </Style>

    <!-- ==================== MARQUEE ====================
         A clipped window that slides its content sideways when the content is
         wider than the box and the pointer is on it. AllowMarquee is read off
         the templated parent, so the shared ComboBox templates below can carry
         the behaviour and leave every dropdown that has not asked for it
         completely unchanged.

         There is deliberately no Canvas in here. A Canvas reports a zero
         DesiredSize.Height to its parent here, which collapsed every dropdown
         row to zero height and left the names invisible. Measured straight, the
         content still reports its true width, because the templates in use (a
         horizontal StackPanel, or a Grid with an Auto column) measure their own
         children against infinity. That true width is the whole point: it is
         what says the name does not fit. -->

    <Style x:Key="MarqueeBox" TargetType="ui:MarqueeBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:MarqueeBox">
                    <Grid x:Name="Clip" Background="Transparent" ClipToBounds="True">
                        <ContentPresenter x:Name="Host" HorizontalAlignment="Left"
                                          VerticalAlignment="Center" RenderTransformOrigin="0,0.5" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Row template for the LOAD WHEN dropdown: launcher icon beside the app name. -->
    <DataTemplate x:Key="AppIconItem">
        <Grid HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="7" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Width="15" Height="15" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Icon}" />
            <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="11.5"
                       Foreground="{StaticResource TextHi}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
    </DataTemplate>

    <Style x:Key="ModernCombo" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource TextHi}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Bd" Background="{StaticResource WellBg}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Padding="9,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:MarqueeBox x:Name="Content" Grid.Column="0" Margin="0,0,6,0"
                                              Style="{StaticResource MarqueeBox}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              AllowMarquee="{Binding (ui:MarqueeBox.AllowMarquee), RelativeSource={RelativeSource TemplatedParent}}" />
                                <Path x:Name="Arrow" Grid.Column="1" Width="8" Height="5" VerticalAlignment="Center"
                                      Data="M 0 0 L 4 4.5 L 8 0 Z" Fill="#7A7A7A" />
                            </Grid>
                        </Border>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                               VerticalOffset="4" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               PopupAnimation="Fade" Focusable="False">
                            <Border Background="#0A0A0A" BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusControl}" Padding="4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LineStrong}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
<Trigger Property="IsKeyboardFocusWithin" Value="True">
<Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FocusRing}" />
<Setter TargetName="Bd" Property="BorderThickness" Value="2" />
</Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Preset picker: taller than a plain combo because it is the page's
         primary control and its text is the answer to "what am I editing". -->
    <Style x:Key="PresetCombo" TargetType="ComboBox" BasedOn="{StaticResource ModernCombo}">
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <!-- Marks a preset the user saved, so the shipped presets and their own are
         told apart at a glance in a list that is otherwise all the same. The chip
         is only shown for custom entries. -->
    <!-- Declared here rather than reused from the window, because a StaticResource
         has to resolve inside its own dictionary at parse time. -->
    <ui:InverseBoolToVisibilityConverter x:Key="ThemeInverseBool" />

    <DataTemplate x:Key="PresetChoiceItem">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            <Border Margin="7,0,0,0" CornerRadius="{StaticResource RadiusChip}" Padding="5,1" VerticalAlignment="Center"
                    Background="#1C1C1C"
                    Visibility="{Binding BuiltIn, Converter={StaticResource ThemeInverseBool}}">
                <TextBlock Text="YOURS" FontSize="8.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextLow}" />
            </Border>
        </StackPanel>
    </DataTemplate>
    <Style x:Key="ModernComboItem" TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource TextHi}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="9,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource RadiusControl}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Elevated}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#123A36" />
                            <Setter Property="Foreground" Value="#7FE8DC" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== CHROME ==================== -->

    <!-- No border and no raised fill: the tab strip sits directly on the
         window's OLED black, so the only chrome is the selected pill. Padding
         is sized to the 46px pill plus its 3px margin so the row never clips. -->
    <Style x:Key="NavTrack" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AppBg}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StatusBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PageBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
          <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <Style x:Key="HiddenTabs" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Border Background="Transparent">
                        <ContentPresenter ContentSource="SelectedContent" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Day / night segmented switch, colour emoji in both states. -->
    <Style x:Key="PillTab" TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="24" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource Emoji}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusControl}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverOverlayStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource FocusRingFill}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource FocusRing}" />
                            <Setter TargetName="Bg" Property="BorderThickness" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Deliberately visible slim bar, used only on the Hotkeys tab, which is the
         one page allowed to scroll because the slot list has no natural ceiling. -->
    <Style x:Key="SlimScroll" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Bar" Background="#2A2A2A" CornerRadius="2" Width="3"
                                                    HorizontalAlignment="Center" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bar" Property="Background" Value="#4A4A4A" />
                                                    <Setter TargetName="Bar" Property="Width" Value="5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ==================== SCROLLBAR ====================
         One scrollbar for the whole app. There used to be two, differing
         only in ways nobody could see: an 8 pixel track with a 4 pixel bar
         against a 10 pixel track with a 3 pixel bar. Two designs for one
         control is one too many, and the slim one's comment claimed it
         was only on the Hotkeys tab when Settings was using it too. The
         implicit style has to come after the keyed one it is based on,
         because a StaticResource resolves in declaration order. -->
    <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScroll}" />

    <Style TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!-- ==================== TOOLTIP ==================== -->

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#101010" />
        <Setter Property="Foreground" Value="#D8D8D8" />
        <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="MaxWidth" Value="260" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusControl}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>








