<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Gamer Tool V2 - zero-external-dependency WPF app with a BUILT-IN
    system-wide EQ engine (GamerToolAPO.dll, a native APO that audiodg.exe
    loads). The APO binary is built from src/Native/GamerToolAPO (MSVC) and
    embedded into this exe as GamerTool.Resources.GamerToolAPO.dll; at
    runtime the enable flow extracts it to %ProgramData%\GamerTool\.
    CI (build.yml) builds the APO first, copies it to
    src/Native/GamerToolAPO/prebuilt/, then publishes this project.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GamerTool</AssemblyName>
    <RootNamespace>GamerTool</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Single-file, self-contained publish target -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>

    <!--
      COM interop (IMMDeviceEnumerator / IPropertyStore) does not trim-safely.
      NOTE: InvariantGlobalization must NEVER be enabled - WPF bindings crash
      at first Window.Show() without ICU culture data.
    -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>

    <ApplicationIcon>Assets\Icons\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Version>2.0.0</Version>
    <Authors>GamerTool</Authors>
    <Product>Gamer Tool</Product>
  </PropertyGroup>

  <!--
    App.xaml lives in src\, but the WPF SDK only auto-detects a root-level
    App.xaml as the ApplicationDefinition (which generates the static Main()
    entry point). Without this explicit include the build fails with CS5001.
  -->
  <ItemGroup>
    <ApplicationDefinition Include="src\App.xaml" />
  </ItemGroup>

  <!--
    The native APO, built by CI into src\Native\GamerToolAPO\prebuilt\, is
    embedded as a resource. The enable flow extracts it at runtime.
    Local development without the C++ toolchain: drop a built DLL at that
    path (or publish with /p:EmbedNativeApo=false to skip it for UI work).
  -->
  <ItemGroup Condition="'$(EmbedNativeApo)' != 'false'">
    <EmbeddedResource Include="src\Native\GamerToolAPO\prebuilt\GamerToolAPO.dll"
                      LogicalName="GamerTool.Resources.GamerToolAPO.dll" />
  </ItemGroup>

  <!--
    Tray icons etc. are Content (copied next to the exe) - TrayManager.cs
    loads them from disk via LoadImage P/Invoke, which requires the files to
    physically exist after publish.
  -->
  <!--
    Assets used at runtime are EMBEDDED resources (not Content) so the
    single-file exe is fully self-contained: tray icons and the preview
    scene load from resource streams; sample.mp3 extracts to %TEMP% once
    for the MediaPlayer. This sidesteps single-file content-extraction
    entirely (AppContext.BaseDirectory never contains Content files in
    a bundled publish).
  -->
  <ItemGroup>
    <!-- IconCatalog uses GDI+ Bitmap for PNG->HICON (tray icon rendering).
         Zero-dependency policy exception: this is a first-party Microsoft
         BCL package, part of the Windows Desktop runtime. -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Icons\tray_idle.ico" LogicalName="GamerTool.Resources.tray_idle.ico" />
    <EmbeddedResource Include="Assets\Icons\tray_active.ico" LogicalName="GamerTool.Resources.tray_active.ico" />
    <EmbeddedResource Include="Assets\PreviewScenes\preview_scene.png" LogicalName="GamerTool.Resources.preview_scene.png" />
    <EmbeddedResource Include="Assets\sample.mp3" LogicalName="GamerTool.Resources.sample.mp3" />
  </ItemGroup>

  <!--
    Preset/combo icon set: FluentUI Emoji (flat), rasterized 32px (UI) and
    20px (tray HICONs). Embedded with stable LogicalNames that IconCatalog
    resolves by key.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\Icons\preset\*_32.png" LogicalName="GamerTool.Resources.icons.%(Filename)" />
    <EmbeddedResource Include="Assets\Icons\preset\tray\*_20.png" LogicalName="GamerTool.Resources.icons.tray.%(Filename)" />
  </ItemGroup>

  <!-- UI glyph PNGs remain Content (used by styles/layouts at build time). -->
  <ItemGroup>
    <Content Include="Assets\Icons\ui\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\PreviewScenes\preview_base_dark_room.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\PreviewScenes\preview_base_dark_room_mask.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\PreviewScenes\preview_enemy_silhouette.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
