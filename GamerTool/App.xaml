<Application x:Class="GamerTool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="UI/CustomSliders.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Accent: a HUD-style electric cyan, distinct from stock Windows blue -->
            <Color x:Key="AccentColor">#FF00E5C7</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FF15161B" />
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF0C0D10" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
