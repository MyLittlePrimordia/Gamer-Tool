<Window x:Class="GamerTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:GamerTool.UI"
        xmlns:models="clr-namespace:GamerTool.Models"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Gamer Tool" Height="640" Width="760"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        Closing="MainWindow_Closing">

    <Window.Resources>
        <local:DbLabelConverter x:Key="DbLabelConverter" />
        <local:PercentLabelConverter x:Key="PercentLabelConverter" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <ObjectDataProvider x:Key="BindingActionValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:BindingAction" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar: output device + panic reset -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="GAMER TOOL" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="EngineStatusText" Text="Audio Engine: checking..."
                           Margin="16,0,0,0" Foreground="#FF9AA0AC" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ComboBox x:Name="OutputDeviceCombo" Width="220" Margin="0,0,8,0"
                          SelectionChanged="OutputDeviceCombo_SelectionChanged" />
                <Button Content="Enable / Repair EQ"
                        Click="EnableAudioEq_Click" Padding="10,4" Margin="0,0,8,0"
                        ToolTip="Installs Equalizer APO if needed and registers it on your default playback device (one UAC prompt)" />
                <Button x:Name="PanicButton" Content="⚠ Panic / Reset Audio"
                        Click="PanicButton_Click" Padding="10,4"
                        Background="#FF3A1414" Foreground="#FFFF8080" BorderThickness="0" />
            </StackPanel>
        </Grid>

        <!-- Tabs -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">

            <!-- ===================== DISPLAY TAB ===================== -->
            <TabItem Header="Display">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="BRIGHTNESS" Foreground="#FF9AA0AC" FontSize="11" Margin="0,8,0,2" />
                        <Slider x:Name="BrightnessSlider" Style="{StaticResource HudSliderHorizontal}"
                                Minimum="-0.3" Maximum="0.3" />

                        <TextBlock Text="CONTRAST" Foreground="#FF9AA0AC" FontSize="11" Margin="0,16,0,2" />
                        <Slider x:Name="ContrastSlider" Style="{StaticResource HudSliderHorizontal}"
                                Minimum="0.5" Maximum="1.8" />

                        <TextBlock Text="GAMMA" Foreground="#FF9AA0AC" FontSize="11" Margin="0,16,0,2" />
                        <Slider x:Name="GammaSlider" Style="{StaticResource HudSliderHorizontal}"
                                Minimum="1.0" Maximum="3.2" />

                        <TextBlock Text="BLACK EQUALIZER (SHADOW BOOST)" Foreground="#FF9AA0AC" FontSize="11" Margin="0,16,0,2" />
                        <Slider x:Name="ShadowBoostSlider" Style="{StaticResource HudSliderHorizontal}"
                                Minimum="0" Maximum="100" />

                        <TextBlock Text="RGB BALANCE" Foreground="#FF9AA0AC" FontSize="11" Margin="0,16,0,2" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="R" Foreground="#FFFF6B6B" Grid.Column="0" VerticalAlignment="Center" />
                            <Slider x:Name="RedSlider" Grid.Column="1" Style="{StaticResource HudSliderHorizontal}"
                                    Minimum="0" Maximum="1" />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="G" Foreground="#FF6BFF8F" Grid.Column="0" VerticalAlignment="Center" />
                            <Slider x:Name="GreenSlider" Grid.Column="1" Style="{StaticResource HudSliderHorizontal}"
                                    Minimum="0" Maximum="1" />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="B" Foreground="#FF6BB8FF" Grid.Column="0" VerticalAlignment="Center" />
                            <Slider x:Name="BlueSlider" Grid.Column="1" Style="{StaticResource HudSliderHorizontal}"
                                    Minimum="0" Maximum="1" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Content="Save As New Preset" Click="SaveDisplayPreset_Click" Padding="10,6" Margin="0,0,8,0" />
                            <Button Content="Delete Preset" Click="DeleteDisplayPreset_Click" Padding="10,6" Margin="0,0,8,0" />
                            <Button Content="Reset to Windows Default" Click="ResetDisplay_Click" Padding="10,6" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="PRESETS" Foreground="#FF9AA0AC" FontSize="11" Margin="0,8,0,4" />
                        <ListBox x:Name="DisplayPresetList" Background="Transparent" BorderThickness="0"
                                 SelectionChanged="DisplayPresetList_SelectionChanged" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ===================== AUDIO TAB ===================== -->
            <TabItem Header="Audio">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Border x:Name="EnableAudioBanner" Background="#FF1E1B0F" BorderBrush="#FFC9A227"
                                BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,4,16,12"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="EnableAudioBannerText"
                                           Text="Audio EQ isn't active on your playback device. Click to install/register (one UAC prompt)."
                                           Foreground="#FFE0C258" VerticalAlignment="Center"
                                           TextWrapping="Wrap" MaxWidth="420" />
                                <Button Content="Enable / Repair Audio EQ" Margin="12,0,0,0" Padding="10,4"
                                        Click="EnableAudioEq_Click" />
                            </StackPanel>
                        </Border>

                        <ItemsControl x:Name="BandSlidersHost" Margin="0,0,16,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <TextBlock Text="PRE-AMP" Foreground="#FF9AA0AC" FontSize="11" Margin="0,20,0,2" />
                        <Slider x:Name="PreampSlider" Style="{StaticResource HudSliderHorizontal}"
                                Minimum="-20" Maximum="15" />

                        <CheckBox x:Name="AntiClipCheck" Content="Anti-Clipping / Auto-Limiter"
                                  Foreground="White" Margin="0,12,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Content="Save As New Preset" Click="SaveAudioPreset_Click" Padding="10,6" Margin="0,0,8,0" />
                            <Button Content="Delete Preset" Click="DeleteAudioPreset_Click" Padding="10,6" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="PRESETS" Foreground="#FF9AA0AC" FontSize="11" Margin="0,8,0,4" />
                        <ListBox x:Name="AudioPresetList" Background="Transparent" BorderThickness="0"
                                 SelectionChanged="AudioPresetList_SelectionChanged" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ===================== HOTKEYS TAB ===================== -->
            <TabItem Header="Hotkeys &amp; Combos">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4,0,12">
                        <Button Content="+ Add Hotkey Binding" Click="AddHotkey_Click" Padding="10,6" Margin="0,0,8,0" />
                        <Button Content="+ New Combo Preset" Click="AddCombo_Click" Padding="10,6" />
                    </StackPanel>

                    <DataGrid x:Name="HotkeyGrid" Grid.Row="1" AutoGenerateColumns="False"
                              Background="Transparent" Foreground="White" BorderThickness="0"
                              CanUserAddRows="False" RowHeight="34"
                              CellEditEnding="HotkeyGrid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Hotkey" Binding="{Binding DisplayText}" Width="140" IsReadOnly="True" />
                            <DataGridComboBoxColumn Header="Action" Width="120" SelectedItemBinding="{Binding Action}"
                                                     ItemsSource="{Binding Source={StaticResource BindingActionValues}}" />
                            <DataGridTextColumn Header="Target Preset / Combo" Binding="{Binding TargetName}" Width="*" />
                            <DataGridTemplateColumn Header="" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remove" Click="RemoveHotkey_Click" Padding="6,2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
