<Window x:Class="GamerTool.UI.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gamer Tool" Height="150" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FF15161B" WindowStyle="ToolWindow">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" Foreground="White" Margin="0,0,0,8" />
        <TextBox x:Name="InputBox" Padding="6" KeyDown="InputBox_KeyDown" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Padding="12,4" Margin="0,0,8,0" />
            <Button Content="OK" Click="Ok_Click" Padding="12,4" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
