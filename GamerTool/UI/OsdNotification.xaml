<Window x:Class="GamerTool.UI.OsdNotification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">
    <Border Background="#CC0C0D10" CornerRadius="8" Padding="16,10"
            BorderBrush="#FF00E5C7" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#FF00E5C7" BlurRadius="18" ShadowDepth="0" Opacity="0.5" />
        </Border.Effect>
        <TextBlock x:Name="MessageText" Foreground="White" FontSize="14" FontWeight="SemiBold" />
    </Border>
</Window>
