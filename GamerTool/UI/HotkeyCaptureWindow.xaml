<Window x:Class="GamerTool.UI.HotkeyCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gamer Tool" Height="160" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FF15161B" WindowStyle="ToolWindow"
        KeyDown="Window_KeyDown" Focusable="True">
    <StackPanel Margin="16" VerticalAlignment="Center">
        <TextBlock Text="Press the key combination you want to bind..."
                   Foreground="#FF9AA0AC" HorizontalAlignment="Center" Margin="0,0,0,12" />
        <TextBlock x:Name="CapturedText" Text="(waiting for keys)" FontSize="20" FontWeight="Bold"
                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Padding="12,4" Margin="0,0,8,0" />
            <Button x:Name="ConfirmButton" Content="Confirm" Click="Confirm_Click" Padding="12,4" IsEnabled="False" />
        </StackPanel>
    </StackPanel>
</Window>
