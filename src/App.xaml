<Application x:Class="GamerTool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <!--
        No StartupUri: App.xaml.cs.OnStartup builds the crash-safety
        subsystem (DisplayManager -> HotkeyManager -> SafetyWatchdog -> panic
        hotkey) in a specific order BEFORE any window exists, then creates
        MainWindow manually. ShutdownMode="OnExplicitShutdown" means hiding
        MainWindow (minimize/close-to-tray) never ends the process - only the
        tray "Exit" command (App.ExitApplication) calls Shutdown().
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Stock WPF converter (System.Windows.Controls.BooleanToVisibilityConverter) - not a custom class, ships in PresentationFramework. -->
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
